"\uc0\u1047 \u1091 \u1087 \u1080 \u1085 \u1082 \u1072  \u1082 \u1088 \u1086 \u1074 \u1086 \u1086 \u1073 \u1110 \u1075 \u1091  \u1091  \u1076 \u1086 \u1088 \u1086 \u1089 \u1083 \u1080 \u1093 ",3,"\u1071 \u1082 \u1097 \u1086  \u1085 \u1077  \u1088 \u1077 \u1072 \u1075 \u1091 \u1108 , \u1079 \u1074 \u1077 \u1088 \u1085 \u1091 \u1090 \u1080 \u1089 \u1103  \u1087 \u1086  \u1076 \u1086 \u1087 \u1086 \u1084 \u1086 \u1075 \u1091  \u1076 \u1086  \u1082 \u1086 \u1085 \u1082 \u1088 \u1077 \u1090 \u1085 \u1086 \u1111  \u1086 \u1089 \u1086 \u1073 \u1080  \u1087 \u1086 \u1088 \u1091 \u1095 ",1,"\u1050 \u1086 \u1085 \u1082 \u1088 \u1077 \u1090 \u1085 \u1077  \u1087 \u1088 \u1086 \u1093 \u1072 \u1085 \u1085 \u1103  \u1089 \u1087 \u1088 \u1072 \u1094 \u1100 \u1086 \u1074 \u1091 \u1108  \u1082 \u1088 \u1072 \u1097 \u1077  \u1079 \u1072  \u1079 \u1072 \u1075 \u1072 \u1083 \u1100 \u1085 \u1080 \u1081  \u1079 \u1072 \u1082 \u1083 \u1080 \u1082 ."\
"\uc0\u1047 \u1091 \u1087 \u1080 \u1085 \u1082 \u1072  \u1082 \u1088 \u1086 \u1074 \u1086 \u1086 \u1073 \u1110 \u1075 \u1091  \u1091  \u1076 \u1086 \u1088 \u1086 \u1089 \u1083 \u1080 \u1093 ",3,"\u1053 \u1077  \u1082 \u1083 \u1080 \u1082 \u1072 \u1090 \u1080  \u1085 \u1110 \u1082 \u1086 \u1075 \u1086 , \u1097 \u1086 \u1073  \u1085 \u1077  \u1087 \u1072 \u1085 \u1110 \u1082 \u1091 \u1074 \u1072 \u1090 \u1080 ",0,"\u1044 \u1086 \u1087 \u1086 \u1084 \u1086 \u1075 \u1072  \u1086 \u1090 \u1086 \u1095 \u1091 \u1102 \u1095 \u1080 \u1093  (\u1074 \u1080 \u1082 \u1083 \u1080 \u1082  \u1096 \u1074 \u1080 \u1076 \u1082 \u1086 \u1111 , \u1087 \u1086 \u1096 \u1091 \u1082  \u1040 \u1047 \u1044 ) \u1076 \u1091 \u1078 \u1077  \u1074 \u1072 \u1078 \u1083 \u1080 \u1074 \u1072 ."\
"\uc0\u1047 \u1091 \u1087 \u1080 \u1085 \u1082 \u1072  \u1082 \u1088 \u1086 \u1074 \u1086 \u1086 \u1073 \u1110 \u1075 \u1091  \u1091  \u1076 \u1086 \u1088 \u1086 \u1089 \u1083 \u1080 \u1093 ",4,"\u1071 \u1082 \u1097 \u1086  \u1083 \u1077 \u1078 \u1080 \u1090 \u1100  \u1085 \u1072  \u1078 \u1080 \u1074 \u1086 \u1090 \u1110 , \u1087 \u1086 \u1074 \u1077 \u1088 \u1085 \u1091 \u1090 \u1080  \u1085 \u1072  \u1089 \u1087 \u1080 \u1085 \u1091  \u1090 \u1072  \u1074 \u1110 \u1076 \u1085 \u1086 \u1074 \u1080 \u1090 \u1080  \u1087 \u1088 \u1086 \u1093 \u1110 \u1076 \u1085 \u1110 \u1089 \u1090 \u1100  \u1076 \u1080 \u1093 \u1072 \u1083 \u1100 \u1085 \u1080 \u1093  \u1096 \u1083 \u1103 \u1093 \u1110 \u1074  (\u1087 \u1088 \u1080  \u1087 \u1110 \u1076 \u1086 \u1079 \u1088 \u1110  \u1085 \u1072  \u1090 \u1088 \u1072 \u1074 \u1084 \u1091  \u1086 \u1073 \u1084 \u1077 \u1078 \u1080 \u1090 \u1080  \u1088 \u1091 \u1093 \u1080  \u1096 \u1080 \u1111 )",1,"\u1057 \u1051 \u1056  \u1084 \u1086 \u1078 \u1085 \u1072  \u1087 \u1088 \u1086 \u1074 \u1086 \u1076 \u1080 \u1090 \u1080  \u1083 \u1080 \u1096 \u1077  \u1085 \u1072  \u1089 \u1087 \u1080 \u1085 \u1110 , \u1072  \u1096 \u1080 \u1103  \u1087 \u1088 \u1080  \u1090 \u1088 \u1072 \u1074 \u1084 \u1110  \u1084 \u1072 \u1108  \u1073 \u1091 \u1090 \u1080  \u1079 \u1072 \u1093 \u1080 \u1097 \u1077 \u1085 \u1072 ."\
"\uc0\u1047 \u1091 \u1087 \u1080 \u1085 \u1082 \u1072  \u1082 \u1088 \u1086 \u1074 \u1086 \u1086 \u1073 \u1110 \u1075 \u1091  \u1091  \u1076 \u1086 \u1088 \u1086 \u1089 \u1083 \u1080 \u1093 ",4,"\u1047 \u1072 \u1083 \u1080 \u1096 \u1080 \u1090 \u1080  \u1087 \u1086 \u1089 \u1090 \u1088 \u1072 \u1078 \u1076 \u1072 \u1083 \u1086 \u1075 \u1086  \u1085 \u1072  \u1078 \u1080 \u1074 \u1086 \u1090 \u1110  \u1081  \u1087 \u1086 \u1095 \u1072 \u1090 \u1080  \u1085 \u1072 \u1090 \u1080 \u1089 \u1082 \u1072 \u1085 \u1085 \u1103  \u1085 \u1072  \u1089 \u1087 \u1080 \u1085 \u1091 ",0,"\u1053 \u1072 \u1090 \u1080 \u1089 \u1082 \u1072 \u1085 \u1085 \u1103  \u1074 \u1080 \u1082 \u1086 \u1085 \u1091 \u1102 \u1090 \u1100  \u1085 \u1072  \u1075 \u1088 \u1091 \u1076 \u1085 \u1091  \u1082 \u1083 \u1110 \u1090 \u1082 \u1091 , \u1090 \u1086 \u1084 \u1091  \u1087 \u1086 \u1089 \u1090 \u1088 \u1072 \u1078 \u1076 \u1072 \u1083 \u1086 \u1075 \u1086  \u1087 \u1086 \u1090 \u1088 \u1110 \u1073 \u1085 \u1086  \u1087 \u1086 \u1074 \u1077 \u1088 \u1085 \u1091 \u1090 \u1080  \u1085 \u1072  \u1089 \u1087 \u1080 \u1085 \u1091 ."\
"\uc0\u1047 \u1091 \u1087 \u1080 \u1085 \u1082 \u1072  \u1082 \u1088 \u1086 \u1074 \u1086 \u1086 \u1073 \u1110 \u1075 \u1091  \u1091  \u1076 \u1086 \u1088 \u1086 \u1089 \u1083 \u1080 \u1093 ",5,"\u1042 \u1080 \u1079 \u1085 \u1072 \u1095 \u1080 \u1090 \u1080  \u1085 \u1072 \u1103 \u1074 \u1085 \u1110 \u1089 \u1090 \u1100  \u1076 \u1080 \u1093 \u1072 \u1085 \u1085 \u1103  \u1087 \u1088 \u1080 \u1081 \u1086 \u1084 \u1086 \u1084  \'ab\u1095 \u1091 \u1090 \u1080 , \u1073 \u1072 \u1095 \u1080 \u1090 \u1080 , \u1074 \u1110 \u1076 \u1095 \u1091 \u1074 \u1072 \u1090 \u1080 \'bb \u1076 \u1086  10 \u1089 \u1077 \u1082 \u1091 \u1085 \u1076 ",1,"\u1062 \u1077  \u1096 \u1074 \u1080 \u1076 \u1082 \u1080 \u1081  \u1110  \u1085 \u1072 \u1076 \u1110 \u1081 \u1085 \u1080 \u1081  \u1089 \u1087 \u1086 \u1089 \u1110 \u1073  \u1086 \u1094 \u1110 \u1085 \u1080 \u1090 \u1080  \u1076 \u1080 \u1093 \u1072 \u1085 \u1085 \u1103 ."\
"\uc0\u1047 \u1091 \u1087 \u1080 \u1085 \u1082 \u1072  \u1082 \u1088 \u1086 \u1074 \u1086 \u1086 \u1073 \u1110 \u1075 \u1091  \u1091  \u1076 \u1086 \u1088 \u1086 \u1089 \u1083 \u1080 \u1093 ",5,"\u1064 \u1091 \u1082 \u1072 \u1090 \u1080  \u1087 \u1091 \u1083 \u1100 \u1089  \u1085 \u1072  \u1096 \u1080 \u1111  \u1087 \u1088 \u1086 \u1090 \u1103 \u1075 \u1086 \u1084  \u1093 \u1074 \u1080 \u1083 \u1080 \u1085 \u1080 ",0,"\u1040 \u1083 \u1075 \u1086 \u1088 \u1080 \u1090 \u1084  \u1076 \u1083 \u1103  \u1085 \u1077 \u1087 \u1088 \u1086 \u1092 \u1077 \u1089 \u1110 \u1086 \u1085 \u1072 \u1083 \u1110 \u1074  \u1087 \u1077 \u1088 \u1077 \u1076 \u1073 \u1072 \u1095 \u1072 \u1108  \u1087 \u1077 \u1088 \u1077 \u1074 \u1110 \u1088 \u1082 \u1091  \u1076 \u1080 \u1093 \u1072 \u1085 \u1085 \u1103 , \u1072  \u1085 \u1077  \u1087 \u1091 \u1083 \u1100 \u1089 \u1091 , \u1110  \u1085 \u1077  \u1076 \u1086 \u1074 \u1096 \u1077  10 \u1089 \u1077 \u1082 \u1091 \u1085 \u1076 ."\
"\uc0\u1047 \u1091 \u1087 \u1080 \u1085 \u1082 \u1072  \u1082 \u1088 \u1086 \u1074 \u1086 \u1086 \u1073 \u1110 \u1075 \u1091  \u1091  \u1076 \u1086 \u1088 \u1086 \u1089 \u1083 \u1080 \u1093 ",6,"\u1071 \u1082 \u1097 \u1086  \u1108  \u1089 \u1091 \u1084 \u1085 \u1110 \u1074 \u1080  \u1072 \u1073 \u1086  \u1076 \u1080 \u1093 \u1072 \u1085 \u1085 \u1103  \u1085 \u1077 \u1085 \u1086 \u1088 \u1084 \u1072 \u1083 \u1100 \u1085 \u1077 , \u1074 \u1074 \u1072 \u1078 \u1072 \u1090 \u1080 , \u1097 \u1086  \u1076 \u1080 \u1093 \u1072 \u1085 \u1085 \u1103  \u1074 \u1110 \u1076 \u1089 \u1091 \u1090 \u1085 \u1108 ",1,"\u1050 \u1088 \u1072 \u1097 \u1077  \u1088 \u1086 \u1079 \u1087 \u1086 \u1095 \u1072 \u1090 \u1080  \u1057 \u1051 \u1056 , \u1085 \u1110 \u1078  \u1087 \u1088 \u1086 \u1087 \u1091 \u1089 \u1090 \u1080 \u1090 \u1080  \u1079 \u1091 \u1087 \u1080 \u1085 \u1082 \u1091  \u1082 \u1088 \u1086 \u1074 \u1086 \u1086 \u1073 \u1110 \u1075 \u1091 ."\
"\uc0\u1047 \u1091 \u1087 \u1080 \u1085 \u1082 \u1072  \u1082 \u1088 \u1086 \u1074 \u1086 \u1086 \u1073 \u1110 \u1075 \u1091  \u1091  \u1076 \u1086 \u1088 \u1086 \u1089 \u1083 \u1080 \u1093 ",6,"\u1071 \u1082 \u1097 \u1086  \u1076 \u1080 \u1093 \u1072 \u1085 \u1085 \u1103  \u1085 \u1077 \u1088 \u1077 \u1075 \u1091 \u1083 \u1103 \u1088 \u1085 \u1077 , \u1087 \u1086 \u1095 \u1077 \u1082 \u1072 \u1090 \u1080 , \u1095 \u1080  \u1085 \u1077  \u1087 \u1086 \u1082 \u1088 \u1072 \u1097 \u1080 \u1090 \u1100 \u1089 \u1103 ",0,"\u1053 \u1077 \u1085 \u1086 \u1088 \u1084 \u1072 \u1083 \u1100 \u1085 \u1077  \u1076 \u1080 \u1093 \u1072 \u1085 \u1085 \u1103  \u1074 \u1074 \u1072 \u1078 \u1072 \u1108 \u1090 \u1100 \u1089 \u1103  \u1074 \u1110 \u1076 \u1089 \u1091 \u1090 \u1085 \u1110 \u1084 ."\
"\uc0\u1047 \u1091 \u1087 \u1080 \u1085 \u1082 \u1072  \u1082 \u1088 \u1086 \u1074 \u1086 \u1086 \u1073 \u1110 \u1075 \u1091  \u1091  \u1076 \u1086 \u1088 \u1086 \u1089 \u1083 \u1080 \u1093 ",7,"\u1071 \u1082 \u1097 \u1086  \u1076 \u1086 \u1088 \u1086 \u1089 \u1083 \u1080 \u1081  \u1073 \u1077 \u1079  \u1089 \u1074 \u1110 \u1076 \u1086 \u1084 \u1086 \u1089 \u1090 \u1110 , \u1072 \u1083 \u1077  \u1076 \u1080 \u1093 \u1072 \u1108  \u1085 \u1086 \u1088 \u1084 \u1072 \u1083 \u1100 \u1085 \u1086 , \u1087 \u1077 \u1088 \u1077 \u1074 \u1077 \u1089 \u1090 \u1080  \u1091  \u1089 \u1090 \u1072 \u1073 \u1110 \u1083 \u1100 \u1085 \u1077  \u1073 \u1086 \u1082 \u1086 \u1074 \u1077  \u1087 \u1086 \u1083 \u1086 \u1078 \u1077 \u1085 \u1085 \u1103 , \u1074 \u1080 \u1082 \u1083 \u1080 \u1082 \u1072 \u1090 \u1080  \u1096 \u1074 \u1080 \u1076 \u1082 \u1091  \u1090 \u1072  \u1087 \u1077 \u1088 \u1077 \u1074 \u1110 \u1088 \u1103 \u1090 \u1080  \u1076 \u1080 \u1093 \u1072 \u1085 \u1085 \u1103  \u1082 \u1086 \u1078 \u1085 \u1110  3\'965 \u1093 \u1074 \u1080 \u1083 \u1080 \u1085 ",1,"\u1041 \u1086 \u1082 \u1086 \u1074 \u1077  \u1087 \u1086 \u1083 \u1086 \u1078 \u1077 \u1085 \u1085 \u1103  \u1079 \u1073 \u1077 \u1088 \u1110 \u1075 \u1072 \u1108  \u1087 \u1088 \u1086 \u1093 \u1110 \u1076 \u1085 \u1110 \u1089 \u1090 \u1100  \u1076 \u1080 \u1093 \u1072 \u1083 \u1100 \u1085 \u1080 \u1093  \u1096 \u1083 \u1103 \u1093 \u1110 \u1074 , \u1072  \u1088 \u1077 \u1075 \u1091 \u1083 \u1103 \u1088 \u1085 \u1072  \u1087 \u1077 \u1088 \u1077 \u1074 \u1110 \u1088 \u1082 \u1072  \u1074 \u1080 \u1103 \u1074 \u1080 \u1090 \u1100  \u1079 \u1091 \u1087 \u1080 \u1085 \u1082 \u1091  \u1076 \u1080 \u1093 \u1072 \u1085 \u1085 \u1103 ."\
"\uc0\u1047 \u1091 \u1087 \u1080 \u1085 \u1082 \u1072  \u1082 \u1088 \u1086 \u1074 \u1086 \u1086 \u1073 \u1110 \u1075 \u1091  \u1091  \u1076 \u1086 \u1088 \u1086 \u1089 \u1083 \u1080 \u1093 ",7,"\u1071 \u1082 \u1097 \u1086  \u1076 \u1086 \u1088 \u1086 \u1089 \u1083 \u1080 \u1081  \u1073 \u1077 \u1079  \u1089 \u1074 \u1110 \u1076 \u1086 \u1084 \u1086 \u1089 \u1090 \u1110 , \u1072 \u1083 \u1077  \u1076 \u1080 \u1093 \u1072 \u1108 , \u1079 \u1072 \u1083 \u1080 \u1096 \u1080 \u1090 \u1080  \u1085 \u1072  \u1089 \u1087 \u1080 \u1085 \u1110  \u1081  \u1087 \u1110 \u1090 \u1080 ",0,"\u1053 \u1072  \u1089 \u1087 \u1080 \u1085 \u1110  \u1103 \u1079 \u1080 \u1082  \u1084 \u1086 \u1078 \u1077  \u1087 \u1077 \u1088 \u1077 \u1082 \u1088 \u1080 \u1090 \u1080  \u1076 \u1080 \u1093 \u1072 \u1083 \u1100 \u1085 \u1110  \u1096 \u1083 \u1103 \u1093 \u1080 . \u1055 \u1086 \u1090 \u1088 \u1110 \u1073 \u1085 \u1077  \u1073 \u1086 \u1082 \u1086 \u1074 \u1077  \u1087 \u1086 \u1083 \u1086 \u1078 \u1077 \u1085 \u1085 \u1103  \u1090 \u1072  \u1085 \u1072 \u1075 \u1083 \u1103 \u1076 ."\
"\uc0\u1047 \u1091 \u1087 \u1080 \u1085 \u1082 \u1072  \u1082 \u1088 \u1086 \u1074 \u1086 \u1086 \u1073 \u1110 \u1075 \u1091  \u1091  \u1076 \u1086 \u1088 \u1086 \u1089 \u1083 \u1080 \u1093 ",7,"\u1071 \u1082 \u1097 \u1086  \u1076 \u1086 \u1088 \u1086 \u1089 \u1083 \u1080 \u1081  \u1073 \u1077 \u1079  \u1089 \u1074 \u1110 \u1076 \u1086 \u1084 \u1086 \u1089 \u1090 \u1110 , \u1072 \u1083 \u1077  \u1076 \u1080 \u1093 \u1072 \u1108 , \u1086 \u1076 \u1088 \u1072 \u1079 \u1091  \u1088 \u1086 \u1079 \u1087 \u1086 \u1095 \u1072 \u1090 \u1080  \u1085 \u1072 \u1090 \u1080 \u1089 \u1082 \u1072 \u1085 \u1085 \u1103  \u1085 \u1072  \u1075 \u1088 \u1091 \u1076 \u1085 \u1091  \u1082 \u1083 \u1110 \u1090 \u1082 \u1091 ",0,"\u1057 \u1051 \u1056  \u1087 \u1088 \u1086 \u1074 \u1086 \u1076 \u1103 \u1090 \u1100  \u1083 \u1080 \u1096 \u1077  \u1079 \u1072  \u1074 \u1110 \u1076 \u1089 \u1091 \u1090 \u1085 \u1086 \u1089 \u1090 \u1110  \u1085 \u1086 \u1088 \u1084 \u1072 \u1083 \u1100 \u1085 \u1086 \u1075 \u1086  \u1076 \u1080 \u1093 \u1072 \u1085 \u1085 \u1103 ."\
"\uc0\u1047 \u1091 \u1087 \u1080 \u1085 \u1082 \u1072  \u1082 \u1088 \u1086 \u1074 \u1086 \u1086 \u1073 \u1110 \u1075 \u1091  \u1091  \u1076 \u1086 \u1088 \u1086 \u1089 \u1083 \u1080 \u1093 ",8,"\u1071 \u1082 \u1097 \u1086  \u1076 \u1080 \u1093 \u1072 \u1085 \u1085 \u1103  \u1074 \u1110 \u1076 \u1089 \u1091 \u1090 \u1085 \u1108 , \u1074 \u1080 \u1082 \u1083 \u1080 \u1082 \u1072 \u1090 \u1080  \u1077 \u1082 \u1089 \u1090 \u1088 \u1077 \u1085 \u1091  \u1076 \u1086 \u1087 \u1086 \u1084 \u1086 \u1075 \u1091  (\u1072 \u1073 \u1086  \u1076 \u1086 \u1088 \u1091 \u1095 \u1080 \u1090 \u1080  \u1094 \u1077  \u1089 \u1074 \u1110 \u1076 \u1082 \u1091 ) \u1090 \u1072  \u1086 \u1076 \u1088 \u1072 \u1079 \u1091  \u1088 \u1086 \u1079 \u1087 \u1086 \u1095 \u1072 \u1090 \u1080  \u1057 \u1051 \u1056 ",1,"\u1056 \u1072 \u1085 \u1085 \u1108  \u1088 \u1086 \u1079 \u1087 \u1086 \u1095 \u1072 \u1090 \u1090 \u1103  \u1057 \u1051 \u1056  \u1110  \u1096 \u1074 \u1080 \u1076 \u1082 \u1080 \u1081  \u1074 \u1080 \u1082 \u1083 \u1080 \u1082  \u1079 \u1073 \u1110 \u1083 \u1100 \u1096 \u1091 \u1102 \u1090 \u1100  \u1096 \u1072 \u1085 \u1089 \u1080  \u1085 \u1072  \u1074 \u1080 \u1078 \u1080 \u1074 \u1072 \u1085 \u1085 \u1103 ."\
"\uc0\u1047 \u1091 \u1087 \u1080 \u1085 \u1082 \u1072  \u1082 \u1088 \u1086 \u1074 \u1086 \u1086 \u1073 \u1110 \u1075 \u1091  \u1091  \u1076 \u1086 \u1088 \u1086 \u1089 \u1083 \u1080 \u1093 ",8,"\u1057 \u1087 \u1077 \u1088 \u1096 \u1091  5 \u1093 \u1074 \u1080 \u1083 \u1080 \u1085  \u1087 \u1088 \u1086 \u1074 \u1086 \u1076 \u1080 \u1090 \u1080  \u1057 \u1051 \u1056 , \u1072  \u1087 \u1086 \u1090 \u1110 \u1084  \u1074 \u1080 \u1082 \u1083 \u1080 \u1082 \u1072 \u1090 \u1080  \u1096 \u1074 \u1080 \u1076 \u1082 \u1091 ",0,"\u1042 \u1080 \u1082 \u1083 \u1080 \u1082  \u1085 \u1077  \u1084 \u1086 \u1078 \u1085 \u1072  \u1074 \u1110 \u1076 \u1082 \u1083 \u1072 \u1076 \u1072 \u1090 \u1080 ."\
"\uc0\u1047 \u1091 \u1087 \u1080 \u1085 \u1082 \u1072  \u1082 \u1088 \u1086 \u1074 \u1086 \u1086 \u1073 \u1110 \u1075 \u1091  \u1091  \u1076 \u1086 \u1088 \u1086 \u1089 \u1083 \u1080 \u1093 ",9,"\u1042 \u1080 \u1082 \u1086 \u1085 \u1072 \u1090 \u1080  30 \u1085 \u1072 \u1090 \u1080 \u1089 \u1082 \u1072 \u1085 \u1100  \u1085 \u1072  \u1089 \u1077 \u1088 \u1077 \u1076 \u1080 \u1085 \u1091  \u1075 \u1088 \u1091 \u1076 \u1085 \u1086 \u1111  \u1082 \u1083 \u1110 \u1090 \u1082 \u1080  \u1075 \u1083 \u1080 \u1073 \u1080 \u1085 \u1086 \u1102  5\'966 \u1089 \u1084  \u1079  \u1095 \u1072 \u1089 \u1090 \u1086 \u1090 \u1086 \u1102  100\'96120 \u1079 \u1072  \u1093 \u1074 \u1080 \u1083 \u1080 \u1085 \u1091 ",1,"\u1058 \u1072 \u1082 \u1072  \u1075 \u1083 \u1080 \u1073 \u1080 \u1085 \u1072  \u1081  \u1095 \u1072 \u1089 \u1090 \u1086 \u1090 \u1072  \u1079 \u1072 \u1073 \u1077 \u1079 \u1087 \u1077 \u1095 \u1091 \u1102 \u1090 \u1100  \u1077 \u1092 \u1077 \u1082 \u1090 \u1080 \u1074 \u1085 \u1080 \u1081  \u1082 \u1088 \u1086 \u1074 \u1086 \u1086 \u1073 \u1110 \u1075 ."\
"\uc0\u1047 \u1091 \u1087 \u1080 \u1085 \u1082 \u1072  \u1082 \u1088 \u1086 \u1074 \u1086 \u1086 \u1073 \u1110 \u1075 \u1091  \u1091  \u1076 \u1086 \u1088 \u1086 \u1089 \u1083 \u1080 \u1093 ",9,"\u1042 \u1080 \u1082 \u1086 \u1085 \u1072 \u1090 \u1080  15 \u1085 \u1072 \u1090 \u1080 \u1089 \u1082 \u1072 \u1085 \u1100  \u1075 \u1083 \u1080 \u1073 \u1080 \u1085 \u1086 \u1102  2\'963 \u1089 \u1084 ",0,"\u1053 \u1072 \u1090 \u1080 \u1089 \u1082 \u1072 \u1085 \u1085 \u1103  \u1085 \u1072 \u1076 \u1090 \u1086  \u1089 \u1083 \u1072 \u1073 \u1082 \u1110  \u1090 \u1072  \u1085 \u1077 \u1095 \u1080 \u1089 \u1083 \u1077 \u1085 \u1085 \u1110 , \u1082 \u1088 \u1086 \u1074 \u1086 \u1086 \u1073 \u1110 \u1075  \u1085 \u1077  \u1073 \u1091 \u1076 \u1077  \u1087 \u1110 \u1076 \u1090 \u1088 \u1080 \u1084 \u1072 \u1085 \u1086 ."\
"\uc0\u1047 \u1091 \u1087 \u1080 \u1085 \u1082 \u1072  \u1082 \u1088 \u1086 \u1074 \u1086 \u1086 \u1073 \u1110 \u1075 \u1091  \u1091  \u1076 \u1086 \u1088 \u1086 \u1089 \u1083 \u1080 \u1093 ",9,"\u1042 \u1080 \u1082 \u1086 \u1085 \u1091 \u1074 \u1072 \u1090 \u1080  \u1085 \u1072 \u1090 \u1080 \u1089 \u1082 \u1072 \u1085 \u1085 \u1103  \u1079  \u1095 \u1072 \u1089 \u1090 \u1086 \u1090 \u1086 \u1102  60 \u1079 \u1072  \u1093 \u1074 \u1080 \u1083 \u1080 \u1085 \u1091 ",0,"\u1047 \u1072 \u1085 \u1072 \u1076 \u1090 \u1086  \u1087 \u1086 \u1074 \u1110 \u1083 \u1100 \u1085 \u1086 , \u1087 \u1086 \u1090 \u1088 \u1110 \u1073 \u1085 \u1086  100\'96120 \u1079 \u1072  \u1093 \u1074 \u1080 \u1083 \u1080 \u1085 \u1091 ."\
"\uc0\u1047 \u1091 \u1087 \u1080 \u1085 \u1082 \u1072  \u1082 \u1088 \u1086 \u1074 \u1086 \u1086 \u1073 \u1110 \u1075 \u1091  \u1091  \u1076 \u1086 \u1088 \u1086 \u1089 \u1083 \u1080 \u1093 ",10,"\u1047 \u1088 \u1086 \u1073 \u1080 \u1090 \u1080  2 \u1074 \u1076 \u1080 \u1093 \u1080  (\u1085 \u1077  \u1076 \u1086 \u1074 \u1096 \u1077  5 \u1089 \u1077 \u1082 \u1091 \u1085 \u1076 ), \u1073 \u1072 \u1078 \u1072 \u1085 \u1086  \u1110 \u1079  \u1079 \u1072 \u1093 \u1080 \u1089 \u1085 \u1080 \u1084  \u1079 \u1072 \u1089 \u1086 \u1073 \u1086 \u1084 . \u1041 \u1077 \u1079  \u1085 \u1100 \u1086 \u1075 \u1086  \u1084 \u1086 \u1078 \u1085 \u1072  \u1087 \u1088 \u1086 \u1074 \u1086 \u1076 \u1080 \u1090 \u1080  \u1083 \u1080 \u1096 \u1077  \u1085 \u1072 \u1090 \u1080 \u1089 \u1082 \u1072 \u1085 \u1085 \u1103 ",1,"\u1042 \u1076 \u1080 \u1093 \u1080  \u1076 \u1086 \u1087 \u1086 \u1074 \u1085 \u1102 \u1102 \u1090 \u1100  \u1085 \u1072 \u1090 \u1080 \u1089 \u1082 \u1072 \u1085 \u1085 \u1103 , \u1072  \u1074 \u1110 \u1076 \u1089 \u1091 \u1090 \u1085 \u1110 \u1089 \u1090 \u1100  \u1079 \u1072 \u1093 \u1080 \u1089 \u1090 \u1091  \u1085 \u1077  \u1087 \u1088 \u1080 \u1074 \u1110 \u1076  \u1074 \u1110 \u1076 \u1084 \u1086 \u1074 \u1083 \u1103 \u1090 \u1080 \u1089 \u1103  \u1074 \u1110 \u1076  \u1057 \u1051 \u1056 ."\
"\uc0\u1047 \u1091 \u1087 \u1080 \u1085 \u1082 \u1072  \u1082 \u1088 \u1086 \u1074 \u1086 \u1086 \u1073 \u1110 \u1075 \u1091  \u1091  \u1076 \u1086 \u1088 \u1086 \u1089 \u1083 \u1080 \u1093 ",10,"\u1047 \u1088 \u1086 \u1073 \u1080 \u1090 \u1080  5 \u1076 \u1086 \u1074 \u1075 \u1080 \u1093  \u1074 \u1076 \u1080 \u1093 \u1110 \u1074  \u1087 \u1086  10 \u1089 \u1077 \u1082 \u1091 \u1085 \u1076 ",0,"\u1042 \u1076 \u1080 \u1093 \u1080  \u1084 \u1072 \u1102 \u1090 \u1100  \u1073 \u1091 \u1090 \u1080  \u1076 \u1074 \u1072 , \u1085 \u1077  \u1076 \u1086 \u1074 \u1096 \u1077  5 \u1089 \u1077 \u1082 \u1091 \u1085 \u1076 , \u1110 \u1085 \u1072 \u1082 \u1096 \u1077  \u1090 \u1088 \u1080 \u1074 \u1072 \u1083 \u1072  \u1087 \u1077 \u1088 \u1077 \u1088 \u1074 \u1072  \u1074  \u1085 \u1072 \u1090 \u1080 \u1089 \u1082 \u1072 \u1085 \u1085 \u1103 \u1093 ."\
"\uc0\u1047 \u1091 \u1087 \u1080 \u1085 \u1082 \u1072  \u1082 \u1088 \u1086 \u1074 \u1086 \u1086 \u1073 \u1110 \u1075 \u1091  \u1091  \u1076 \u1086 \u1088 \u1086 \u1089 \u1083 \u1080 \u1093 ",11,"\u1053 \u1077  \u1087 \u1077 \u1088 \u1077 \u1088 \u1080 \u1074 \u1072 \u1090 \u1080  \u1085 \u1072 \u1090 \u1080 \u1089 \u1082 \u1072 \u1085 \u1085 \u1103  \u1073 \u1110 \u1083 \u1100 \u1096 \u1077  \u1085 \u1110 \u1078  \u1085 \u1072  10 \u1089 \u1077 \u1082 \u1091 \u1085 \u1076 ",1,"\u1050 \u1086 \u1078 \u1085 \u1072  \u1087 \u1072 \u1091 \u1079 \u1072  \u1079 \u1085 \u1080 \u1078 \u1091 \u1108  \u1090 \u1080 \u1089 \u1082  \u1082 \u1088 \u1086 \u1074 \u1110  \u1091  \u1089 \u1091 \u1076 \u1080 \u1085 \u1072 \u1093 ."\
"\uc0\u1047 \u1091 \u1087 \u1080 \u1085 \u1082 \u1072  \u1082 \u1088 \u1086 \u1074 \u1086 \u1086 \u1073 \u1110 \u1075 \u1091  \u1091  \u1076 \u1086 \u1088 \u1086 \u1089 \u1083 \u1080 \u1093 ",11,"\u1047 \u1088 \u1086 \u1073 \u1080 \u1090 \u1080  \u1087 \u1077 \u1088 \u1077 \u1088 \u1074 \u1091  \u1085 \u1072  \u1093 \u1074 \u1080 \u1083 \u1080 \u1085 \u1091 , \u1097 \u1086 \u1073  \u1087 \u1077 \u1088 \u1077 \u1087 \u1086 \u1095 \u1080 \u1090 \u1080 ",0,"\u1058 \u1088 \u1080 \u1074 \u1072 \u1083 \u1072  \u1087 \u1077 \u1088 \u1077 \u1088 \u1074 \u1072  \u1088 \u1091 \u1081 \u1085 \u1091 \u1108  \u1077 \u1092 \u1077 \u1082 \u1090  \u1057 \u1051 \u1056 ."\
"\uc0\u1047 \u1091 \u1087 \u1080 \u1085 \u1082 \u1072  \u1082 \u1088 \u1086 \u1074 \u1086 \u1086 \u1073 \u1110 \u1075 \u1091  \u1091  \u1076 \u1086 \u1088 \u1086 \u1089 \u1083 \u1080 \u1093 ",12,"\u1047 \u1084 \u1110 \u1085 \u1102 \u1074 \u1072 \u1090 \u1080  \u1086 \u1089 \u1086 \u1073 \u1091 , \u1097 \u1086  \u1074 \u1080 \u1082 \u1086 \u1085 \u1091 \u1108  \u1085 \u1072 \u1090 \u1080 \u1089 \u1082 \u1072 \u1085 \u1085 \u1103 , \u1082 \u1086 \u1078 \u1085 \u1110  2 \u1093 \u1074 \u1080 \u1083 \u1080 \u1085 \u1080  (\u1072 \u1073 \u1086  \u1088 \u1072 \u1085 \u1110 \u1096 \u1077  \u1087 \u1088 \u1080  \u1074 \u1090 \u1086 \u1084 \u1110 )",1,"\u1042 \u1090 \u1086 \u1084 \u1072  \u1079 \u1085 \u1080 \u1078 \u1091 \u1108  \u1103 \u1082 \u1110 \u1089 \u1090 \u1100  \u1085 \u1072 \u1090 \u1080 \u1089 \u1082 \u1072 \u1085 \u1100 ."\
"\uc0\u1047 \u1091 \u1087 \u1080 \u1085 \u1082 \u1072  \u1082 \u1088 \u1086 \u1074 \u1086 \u1086 \u1073 \u1110 \u1075 \u1091  \u1091  \u1076 \u1086 \u1088 \u1086 \u1089 \u1083 \u1080 \u1093 ",12,"\u1054 \u1076 \u1085 \u1072  \u1083 \u1102 \u1076 \u1080 \u1085 \u1072  \u1084 \u1072 \u1108  \u1088 \u1086 \u1073 \u1080 \u1090 \u1080  \u1085 \u1072 \u1090 \u1080 \u1089 \u1082 \u1072 \u1085 \u1085 \u1103  \u1076 \u1086  \u1087 \u1086 \u1074 \u1085 \u1086 \u1075 \u1086  \u1074 \u1080 \u1089 \u1085 \u1072 \u1078 \u1077 \u1085 \u1085 \u1103  \u1073 \u1077 \u1079  \u1079 \u1072 \u1084 \u1110 \u1085 \u1080 ",0,"\u1071 \u1082 \u1110 \u1089 \u1090 \u1100  \u1085 \u1072 \u1090 \u1080 \u1089 \u1082 \u1072 \u1085 \u1100  \u1096 \u1074 \u1080 \u1076 \u1082 \u1086  \u1087 \u1072 \u1076 \u1072 \u1108 , \u1087 \u1086 \u1090 \u1088 \u1110 \u1073 \u1085 \u1072  \u1079 \u1072 \u1084 \u1110 \u1085 \u1072  \u1082 \u1086 \u1078 \u1085 \u1110  2 \u1093 \u1074 \u1080 \u1083 \u1080 \u1085 \u1080 ."\
"\uc0\u1047 \u1091 \u1087 \u1080 \u1085 \u1082 \u1072  \u1082 \u1088 \u1086 \u1074 \u1086 \u1086 \u1073 \u1110 \u1075 \u1091  \u1091  \u1076 \u1086 \u1088 \u1086 \u1089 \u1083 \u1080 \u1093 ",13,"\u1071 \u1082 \u1097 \u1086  \u1088 \u1103 \u1090 \u1110 \u1074 \u1085 \u1080 \u1082  \u1086 \u1076 \u1080 \u1085  \u1110  \u1040 \u1047 \u1044  \u1087 \u1086 \u1073 \u1083 \u1080 \u1079 \u1091  \u1085 \u1077 \u1084 \u1072 \u1108 , \u1085 \u1077  \u1079 \u1072 \u1083 \u1080 \u1096 \u1072 \u1090 \u1080  \u1087 \u1086 \u1089 \u1090 \u1088 \u1072 \u1078 \u1076 \u1072 \u1083 \u1086 \u1075 \u1086  \u1076 \u1083 \u1103  \u1087 \u1086 \u1096 \u1091 \u1082 \u1110 \u1074  \u1076 \u1077 \u1092 \u1110 \u1073 \u1088 \u1080 \u1083 \u1103 \u1090 \u1086 \u1088 \u1072 ",1,"\u1040 \u1083 \u1075 \u1086 \u1088 \u1080 \u1090 \u1084  \u1074 \u1080 \u1084 \u1072 \u1075 \u1072 \u1108  \u1087 \u1088 \u1086 \u1074 \u1086 \u1076 \u1080 \u1090 \u1080  \u1057 \u1051 \u1056 , \u1072  \u1085 \u1077  \u1079 \u1072 \u1083 \u1080 \u1096 \u1072 \u1090 \u1080  \u1083 \u1102 \u1076 \u1080 \u1085 \u1091 ."\
"\uc0\u1047 \u1091 \u1087 \u1080 \u1085 \u1082 \u1072  \u1082 \u1088 \u1086 \u1074 \u1086 \u1086 \u1073 \u1110 \u1075 \u1091  \u1091  \u1076 \u1086 \u1088 \u1086 \u1089 \u1083 \u1080 \u1093 ",13,"\u1047 \u1072 \u1083 \u1080 \u1096 \u1080 \u1090 \u1080  \u1087 \u1086 \u1089 \u1090 \u1088 \u1072 \u1078 \u1076 \u1072 \u1083 \u1086 \u1075 \u1086  \u1081  \u1087 \u1110 \u1090 \u1080  \u1096 \u1091 \u1082 \u1072 \u1090 \u1080  \u1076 \u1077 \u1092 \u1110 \u1073 \u1088 \u1080 \u1083 \u1103 \u1090 \u1086 \u1088 ",0,"\u1041 \u1077 \u1079  \u1057 \u1051 \u1056  \u1082 \u1088 \u1086 \u1074 \u1086 \u1086 \u1073 \u1110 \u1075  \u1085 \u1077  \u1087 \u1110 \u1076 \u1090 \u1088 \u1080 \u1084 \u1091 \u1108 \u1090 \u1100 \u1089 \u1103 ."\
"\uc0\u1047 \u1091 \u1087 \u1080 \u1085 \u1082 \u1072  \u1082 \u1088 \u1086 \u1074 \u1086 \u1086 \u1073 \u1110 \u1075 \u1091  \u1091  \u1076 \u1086 \u1088 \u1086 \u1089 \u1083 \u1080 \u1093 ",14,"\u1050 \u1086 \u1083 \u1080  \u1079 '\u1103 \u1074 \u1080 \u1074 \u1089 \u1103  \u1040 \u1047 \u1044 , \u1085 \u1077 \u1075 \u1072 \u1081 \u1085 \u1086  \u1091 \u1074 \u1110 \u1084 \u1082 \u1085 \u1091 \u1090 \u1080  \u1081 \u1086 \u1075 \u1086  \u1090 \u1072  \u1074 \u1080 \u1082 \u1086 \u1085 \u1091 \u1074 \u1072 \u1090 \u1080  \u1075 \u1086 \u1083 \u1086 \u1089 \u1086 \u1074 \u1110  \u1074 \u1082 \u1072 \u1079 \u1110 \u1074 \u1082 \u1080  (\u1079 \u1072  \u1085 \u1072 \u1103 \u1074 \u1085 \u1086 \u1089 \u1090 \u1110  \u1087 \u1086 \u1084 \u1110 \u1095 \u1085 \u1080 \u1082 \u1110 \u1074  \u1077 \u1083 \u1077 \u1082 \u1090 \u1088 \u1086 \u1076 \u1080  \u1082 \u1083 \u1077 \u1111 \u1090 \u1080  \u1087 \u1110 \u1076  \u1095 \u1072 \u1089  \u1085 \u1072 \u1090 \u1080 \u1089 \u1082 \u1072 \u1085 \u1100 )",1,"\u1040 \u1047 \u1044  \u1072 \u1085 \u1072 \u1083 \u1110 \u1079 \u1091 \u1108  \u1088 \u1080 \u1090 \u1084  \u1110  \u1087 \u1110 \u1076 \u1082 \u1072 \u1079 \u1091 \u1108 , \u1082 \u1086 \u1083 \u1080  \u1087 \u1086 \u1090 \u1088 \u1110 \u1073 \u1077 \u1085  \u1088 \u1086 \u1079 \u1088 \u1103 \u1076 ."\
"\uc0\u1047 \u1091 \u1087 \u1080 \u1085 \u1082 \u1072  \u1082 \u1088 \u1086 \u1074 \u1086 \u1086 \u1073 \u1110 \u1075 \u1091  \u1091  \u1076 \u1086 \u1088 \u1086 \u1089 \u1083 \u1080 \u1093 ",14,"\u1055 \u1077 \u1088 \u1077 \u1076  \u1074 \u1080 \u1082 \u1086 \u1088 \u1080 \u1089 \u1090 \u1072 \u1085 \u1085 \u1103 \u1084  \u1040 \u1047 \u1044  \u1079 \u1091 \u1087 \u1080 \u1085 \u1080 \u1090 \u1080  \u1057 \u1051 \u1056  \u1110  \u1095 \u1077 \u1082 \u1072 \u1090 \u1080  \u1082 \u1110 \u1083 \u1100 \u1082 \u1072  \u1093 \u1074 \u1080 \u1083 \u1080 \u1085 ",0,"\u1055 \u1077 \u1088 \u1077 \u1088 \u1074 \u1080  \u1074  \u1085 \u1072 \u1090 \u1080 \u1089 \u1082 \u1072 \u1085 \u1085 \u1103 \u1093  \u1096 \u1082 \u1086 \u1076 \u1103 \u1090 \u1100 , \u1087 \u1088 \u1080  \u1087 \u1086 \u1084 \u1110 \u1095 \u1085 \u1080 \u1082 \u1072 \u1093  \u1077 \u1083 \u1077 \u1082 \u1090 \u1088 \u1086 \u1076 \u1080  \u1082 \u1083 \u1077 \u1103 \u1090 \u1100  \u1087 \u1110 \u1076  \u1095 \u1072 \u1089  \u1082 \u1086 \u1084 \u1087 \u1088 \u1077 \u1089 \u1110 \u1081 ."\
"\uc0\u1047 \u1091 \u1087 \u1080 \u1085 \u1082 \u1072  \u1082 \u1088 \u1086 \u1074 \u1086 \u1086 \u1073 \u1110 \u1075 \u1091  \u1091  \u1076 \u1086 \u1088 \u1086 \u1089 \u1083 \u1080 \u1093 ",15,"\u1055 \u1077 \u1088 \u1077 \u1076  \u1076 \u1077 \u1092 \u1110 \u1073 \u1088 \u1080 \u1083 \u1103 \u1094 \u1110 \u1108 \u1102  \u1087 \u1077 \u1088 \u1077 \u1082 \u1086 \u1085 \u1072 \u1090 \u1080 \u1089 \u1103 , \u1097 \u1086  \u1085 \u1110 \u1093 \u1090 \u1086  \u1085 \u1077  \u1090 \u1086 \u1088 \u1082 \u1072 \u1108 \u1090 \u1100 \u1089 \u1103  \u1087 \u1086 \u1089 \u1090 \u1088 \u1072 \u1078 \u1076 \u1072 \u1083 \u1086 \u1075 \u1086 , \u1072  \u1087 \u1110 \u1089 \u1083 \u1103  \u1088 \u1086 \u1079 \u1088 \u1103 \u1076 \u1091  \u1085 \u1077 \u1075 \u1072 \u1081 \u1085 \u1086  \u1087 \u1088 \u1086 \u1076 \u1086 \u1074 \u1078 \u1080 \u1090 \u1080  \u1085 \u1072 \u1090 \u1080 \u1089 \u1082 \u1072 \u1085 \u1085 \u1103 ",1,"\u1062 \u1077  \u1079 \u1072 \u1093 \u1080 \u1097 \u1072 \u1108  \u1088 \u1103 \u1090 \u1110 \u1074 \u1085 \u1080 \u1082 \u1110 \u1074  \u1074 \u1110 \u1076  \u1091 \u1076 \u1072 \u1088 \u1091  \u1089 \u1090 \u1088 \u1091 \u1084 \u1086 \u1084 , \u1072  \u1073 \u1077 \u1079 \u1087 \u1077 \u1088 \u1077 \u1088 \u1074 \u1085 \u1072  \u1057 \u1051 \u1056  \u1087 \u1110 \u1076 \u1090 \u1088 \u1080 \u1084 \u1091 \u1108  \u1082 \u1088 \u1086 \u1074 \u1086 \u1086 \u1073 \u1110 \u1075 ."\
"\uc0\u1047 \u1091 \u1087 \u1080 \u1085 \u1082 \u1072  \u1082 \u1088 \u1086 \u1074 \u1086 \u1086 \u1073 \u1110 \u1075 \u1091  \u1091  \u1076 \u1086 \u1088 \u1086 \u1089 \u1083 \u1080 \u1093 ",15,"\u1058 \u1086 \u1088 \u1082 \u1072 \u1090 \u1080 \u1089 \u1103  \u1087 \u1086 \u1089 \u1090 \u1088 \u1072 \u1078 \u1076 \u1072 \u1083 \u1086 \u1075 \u1086  \u1087 \u1110 \u1076  \u1095 \u1072 \u1089  \u1088 \u1086 \u1079 \u1088 \u1103 \u1076 \u1091 , \u1097 \u1086 \u1073  \u1085 \u1077  \u1074 \u1090 \u1088 \u1072 \u1090 \u1080 \u1090 \u1080  \u1090 \u1077 \u1084 \u1087  \u1085 \u1072 \u1090 \u1080 \u1089 \u1082 \u1072 \u1085 \u1100 ",0,"\u1028  \u1088 \u1080 \u1079 \u1080 \u1082  \u1091 \u1088 \u1072 \u1078 \u1077 \u1085 \u1085 \u1103  \u1089 \u1090 \u1088 \u1091 \u1084 \u1086 \u1084 ."\
"\uc0\u1047 \u1091 \u1087 \u1080 \u1085 \u1082 \u1072  \u1082 \u1088 \u1086 \u1074 \u1086 \u1086 \u1073 \u1110 \u1075 \u1091  \u1091  \u1076 \u1086 \u1088 \u1086 \u1089 \u1083 \u1080 \u1093 ",16,"\u1055 \u1088 \u1080 \u1087 \u1080 \u1085 \u1103 \u1090 \u1080  \u1057 \u1051 \u1056  \u1083 \u1080 \u1096 \u1077  \u1079 \u1072  \u1087 \u1086 \u1103 \u1074 \u1080  \u1103 \u1074 \u1085 \u1080 \u1093  \u1086 \u1079 \u1085 \u1072 \u1082  \u1078 \u1080 \u1090 \u1090 \u1103 , \u1087 \u1088 \u1080  \u1079 \u1072 \u1075 \u1088 \u1086 \u1079 \u1110  \u1078 \u1080 \u1090 \u1090 \u1102  \u1088 \u1103 \u1090 \u1110 \u1074 \u1085 \u1080 \u1082 \u1072  \u1072 \u1073 \u1086  \u1087 \u1088 \u1080  \u1087 \u1086 \u1074 \u1085 \u1086 \u1084 \u1091  \u1074 \u1080 \u1089 \u1085 \u1072 \u1078 \u1077 \u1085 \u1085 \u1110 , \u1095 \u1080  \u1087 \u1110 \u1089 \u1083 \u1103  \u1087 \u1088 \u1080 \u1111 \u1079 \u1076 \u1091  \u1073 \u1088 \u1080 \u1075 \u1072 \u1076 \u1080 ",1,"\u1055 \u1077 \u1088 \u1077 \u1083 \u1110 \u1082  \u1087 \u1110 \u1076 \u1089 \u1090 \u1072 \u1074  \u1076 \u1083 \u1103  \u1079 \u1091 \u1087 \u1080 \u1085 \u1082 \u1080  \u1057 \u1051 \u1056  \u1095 \u1110 \u1090 \u1082 \u1086  \u1074 \u1080 \u1079 \u1085 \u1072 \u1095 \u1077 \u1085 \u1080 \u1081  \u1072 \u1083 \u1075 \u1086 \u1088 \u1080 \u1090 \u1084 \u1086 \u1084 ."\
"\uc0\u1047 \u1091 \u1087 \u1080 \u1085 \u1082 \u1072  \u1082 \u1088 \u1086 \u1074 \u1086 \u1086 \u1073 \u1110 \u1075 \u1091  \u1091  \u1076 \u1086 \u1088 \u1086 \u1089 \u1083 \u1080 \u1093 ",16,"\u1055 \u1088 \u1080 \u1087 \u1080 \u1085 \u1080 \u1090 \u1080  \u1057 \u1051 \u1056  \u1095 \u1077 \u1088 \u1077 \u1079  5 \u1093 \u1074 \u1080 \u1083 \u1080 \u1085 , \u1103 \u1082 \u1097 \u1086  \u1085 \u1077 \u1084 \u1072 \u1108  \u1088 \u1077 \u1079 \u1091 \u1083 \u1100 \u1090 \u1072 \u1090 \u1091 ",0,"\u1054 \u1073 \u1084 \u1077 \u1078 \u1077 \u1085 \u1085 \u1103  \u1079 \u1072  \u1095 \u1072 \u1089 \u1086 \u1084  \u1072 \u1083 \u1075 \u1086 \u1088 \u1080 \u1090 \u1084 \u1086 \u1084  \u1085 \u1077  \u1087 \u1077 \u1088 \u1077 \u1076 \u1073 \u1072 \u1095 \u1077 \u1085 \u1086 ."}