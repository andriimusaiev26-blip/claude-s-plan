"\uc0\u1054 \u1087 \u1110 \u1082 \u1080 ",8,"\u1055 \u1088 \u1086 \u1082 \u1086 \u1083 \u1086 \u1090 \u1080  \u1084 \u1110 \u1093 \u1091 \u1088 \u1080  \u1089 \u1090 \u1077 \u1088 \u1080 \u1083 \u1100 \u1085 \u1086 \u1102  \u1075 \u1086 \u1083 \u1082 \u1086 \u1102 ",0,"\u1055 \u1088 \u1086 \u1082 \u1086 \u1083 \u1102 \u1074 \u1072 \u1085 \u1085 \u1103  \u1074 \u1110 \u1076 \u1082 \u1088 \u1080 \u1074 \u1072 \u1108  \u1096 \u1083 \u1103 \u1093  \u1110 \u1085 \u1092 \u1077 \u1082 \u1094 \u1110 \u1111 . \u1040 \u1083 \u1075 \u1086 \u1088 \u1080 \u1090 \u1084  \u1079 \u1072 \u1073 \u1086 \u1088 \u1086 \u1085 \u1103 \u1108  \u1087 \u1086 \u1096 \u1082 \u1086 \u1076 \u1078 \u1091 \u1074 \u1072 \u1090 \u1080  \u1084 \u1110 \u1093 \u1091 \u1088 \u1080 ."\
"\uc0\u1054 \u1087 \u1110 \u1082 \u1080 ",9,"\u1055 \u1088 \u1080  \u1086 \u1087 \u1110 \u1082 \u1091  \u1087 \u1086 \u1085 \u1072 \u1076  20% \u1087 \u1083 \u1086 \u1097 \u1110  \u1090 \u1110 \u1083 \u1072  \u1091  \u1076 \u1086 \u1088 \u1086 \u1089 \u1083 \u1080 \u1093  (10% \u1091  \u1076 \u1110 \u1090 \u1077 \u1081 ) \u1085 \u1072 \u1082 \u1088 \u1080 \u1090 \u1080  \u1087 \u1086 \u1089 \u1090 \u1088 \u1072 \u1078 \u1076 \u1072 \u1083 \u1086 \u1075 \u1086  \u1090 \u1077 \u1088 \u1084 \u1086 \u1087 \u1086 \u1082 \u1088 \u1080 \u1074 \u1072 \u1083 \u1086 \u1084 ",1,"\u1055 \u1088 \u1080  \u1074 \u1077 \u1083 \u1080 \u1082 \u1110 \u1081  \u1087 \u1083 \u1086 \u1097 \u1110  \u1086 \u1087 \u1110 \u1082 \u1091  \u1096 \u1074 \u1080 \u1076 \u1082 \u1086  \u1085 \u1072 \u1089 \u1090 \u1072 \u1108  \u1074 \u1090 \u1088 \u1072 \u1090 \u1072  \u1090 \u1077 \u1087 \u1083 \u1072 , \u1090 \u1086 \u1084 \u1091  \u1087 \u1086 \u1089 \u1090 \u1088 \u1072 \u1078 \u1076 \u1072 \u1083 \u1086 \u1075 \u1086  \u1087 \u1086 \u1090 \u1088 \u1110 \u1073 \u1085 \u1086  \u1079 \u1110 \u1075 \u1088 \u1110 \u1074 \u1072 \u1090 \u1080 ."\
"\uc0\u1054 \u1087 \u1110 \u1082 \u1080 ",9,"\u1055 \u1088 \u1080  \u1074 \u1077 \u1083 \u1080 \u1082 \u1086 \u1084 \u1091  \u1086 \u1087 \u1110 \u1082 \u1091  \u1087 \u1088 \u1086 \u1076 \u1086 \u1074 \u1078 \u1091 \u1074 \u1072 \u1090 \u1080  \u1086 \u1093 \u1086 \u1083 \u1086 \u1076 \u1078 \u1091 \u1074 \u1072 \u1090 \u1080  \u1074 \u1089 \u1077  \u1090 \u1110 \u1083 \u1086  \u1093 \u1086 \u1083 \u1086 \u1076 \u1085 \u1086 \u1102  \u1074 \u1086 \u1076 \u1086 \u1102 ",0,"\u1055 \u1088 \u1080  \u1074 \u1077 \u1083 \u1080 \u1082 \u1110 \u1081  \u1087 \u1083 \u1086 \u1097 \u1110  \u1086 \u1087 \u1110 \u1082 \u1091  \u1086 \u1093 \u1086 \u1083 \u1086 \u1076 \u1078 \u1077 \u1085 \u1085 \u1103  \u1074 \u1086 \u1076 \u1086 \u1102  \u1085 \u1077  \u1087 \u1086 \u1082 \u1072 \u1079 \u1072 \u1085 \u1077 , \u1073 \u1086  \u1074 \u1080 \u1085 \u1080 \u1082 \u1072 \u1108  \u1088 \u1080 \u1079 \u1080 \u1082  \u1087 \u1077 \u1088 \u1077 \u1086 \u1093 \u1086 \u1083 \u1086 \u1076 \u1078 \u1077 \u1085 \u1085 \u1103 . \u1055 \u1086 \u1090 \u1088 \u1110 \u1073 \u1085 \u1086  \u1085 \u1072 \u1082 \u1088 \u1080 \u1090 \u1080  \u1087 \u1086 \u1089 \u1090 \u1088 \u1072 \u1078 \u1076 \u1072 \u1083 \u1086 \u1075 \u1086 ."\
"\uc0\u1054 \u1087 \u1110 \u1082 \u1080 ",10,"\u1047 \u1072 \u1073 \u1077 \u1079 \u1087 \u1077 \u1095 \u1080 \u1090 \u1080  \u1087 \u1086 \u1089 \u1090 \u1110 \u1081 \u1085 \u1080 \u1081  \u1085 \u1072 \u1075 \u1083 \u1103 \u1076  \u1079 \u1072  \u1087 \u1086 \u1089 \u1090 \u1088 \u1072 \u1078 \u1076 \u1072 \u1083 \u1080 \u1084  \u1076 \u1086  \u1087 \u1088 \u1080 \u1111 \u1079 \u1076 \u1091  \u1073 \u1088 \u1080 \u1075 \u1072 \u1076 \u1080 ",1,"\u1057 \u1090 \u1072 \u1085  \u1084 \u1086 \u1078 \u1077  \u1087 \u1086 \u1075 \u1110 \u1088 \u1096 \u1080 \u1090 \u1080 \u1089 \u1103  \u1074  \u1073 \u1091 \u1076 \u1100 -\u1103 \u1082 \u1080 \u1081  \u1084 \u1086 \u1084 \u1077 \u1085 \u1090 ."\
"\uc0\u1054 \u1087 \u1110 \u1082 \u1080 ",10,"\u1047 \u1072 \u1083 \u1080 \u1096 \u1080 \u1090 \u1080  \u1087 \u1086 \u1089 \u1090 \u1088 \u1072 \u1078 \u1076 \u1072 \u1083 \u1086 \u1075 \u1086  \u1089 \u1072 \u1084 \u1086 \u1075 \u1086 , \u1087 \u1086 \u1082 \u1080  \u1074 \u1110 \u1085  \u1079 \u1076 \u1072 \u1108 \u1090 \u1100 \u1089 \u1103  \u1089 \u1087 \u1086 \u1082 \u1110 \u1081 \u1085 \u1080 \u1084 ",0,"\u1041 \u1077 \u1079  \u1085 \u1072 \u1075 \u1083 \u1103 \u1076 \u1091  \u1087 \u1086 \u1075 \u1110 \u1088 \u1096 \u1077 \u1085 \u1085 \u1103  \u1089 \u1090 \u1072 \u1085 \u1091  \u1084 \u1086 \u1078 \u1085 \u1072  \u1087 \u1088 \u1086 \u1087 \u1091 \u1089 \u1090 \u1080 \u1090 \u1080 ."\
"\uc0\u1054 \u1087 \u1110 \u1082 \u1080 ",11,"\u1055 \u1088 \u1080  \u1087 \u1086 \u1075 \u1110 \u1088 \u1096 \u1077 \u1085 \u1085 \u1110  \u1089 \u1090 \u1072 \u1085 \u1091  \u1087 \u1086 \u1074 \u1090 \u1086 \u1088 \u1085 \u1086  \u1079 \u1072 \u1090 \u1077 \u1083 \u1077 \u1092 \u1086 \u1085 \u1091 \u1074 \u1072 \u1090 \u1080  \u1076 \u1080 \u1089 \u1087 \u1077 \u1090 \u1095 \u1077 \u1088 \u1091  \u1077 \u1082 \u1089 \u1090 \u1088 \u1077 \u1085 \u1086 \u1111  \u1076 \u1086 \u1087 \u1086 \u1084 \u1086 \u1075 \u1080 ",1,"\u1044 \u1080 \u1089 \u1087 \u1077 \u1090 \u1095 \u1077 \u1088  \u1084 \u1072 \u1108  \u1079 \u1085 \u1072 \u1090 \u1080  \u1087 \u1088 \u1086  \u1079 \u1084 \u1110 \u1085 \u1091  \u1089 \u1090 \u1072 \u1085 \u1091 , \u1097 \u1086 \u1073  \u1076 \u1072 \u1090 \u1080  \u1085 \u1086 \u1074 \u1110  \u1074 \u1082 \u1072 \u1079 \u1110 \u1074 \u1082 \u1080  \u1090 \u1072  \u1074 \u1088 \u1072 \u1093 \u1091 \u1074 \u1072 \u1090 \u1080  \u1094 \u1077 ."\
"\uc0\u1054 \u1087 \u1110 \u1082 \u1080 ",11,"\u1063 \u1077 \u1082 \u1072 \u1090 \u1080  \u1073 \u1088 \u1080 \u1075 \u1072 \u1076 \u1091  \u1073 \u1077 \u1079  \u1076 \u1086 \u1076 \u1072 \u1090 \u1082 \u1086 \u1074 \u1080 \u1093  \u1076 \u1079 \u1074 \u1110 \u1085 \u1082 \u1110 \u1074 ",0,"\u1055 \u1086 \u1075 \u1110 \u1088 \u1096 \u1077 \u1085 \u1085 \u1103  \u1089 \u1090 \u1072 \u1085 \u1091  \u1074 \u1080 \u1084 \u1072 \u1075 \u1072 \u1108  \u1087 \u1086 \u1074 \u1090 \u1086 \u1088 \u1085 \u1086 \u1075 \u1086  \u1074 \u1080 \u1082 \u1083 \u1080 \u1082 \u1091 ."\
"\uc0\u1054 \u1087 \u1110 \u1082 \u1080 ",12,"\u1047 \u1110 \u1073 \u1088 \u1072 \u1090 \u1080  \u1110 \u1085 \u1092 \u1086 \u1088 \u1084 \u1072 \u1094 \u1110 \u1102  \u1087 \u1088 \u1086  \u1086 \u1073 \u1089 \u1090 \u1072 \u1074 \u1080 \u1085 \u1080  \u1090 \u1088 \u1072 \u1074 \u1084 \u1080  \u1090 \u1072  \u1087 \u1077 \u1088 \u1077 \u1076 \u1072 \u1090 \u1080  \u1111 \u1111  \u1073 \u1088 \u1080 \u1075 \u1072 \u1076 \u1110  \u1096 \u1074 \u1080 \u1076 \u1082 \u1086 \u1111  \u1076 \u1086 \u1087 \u1086 \u1084 \u1086 \u1075 \u1080  \u1072 \u1073 \u1086  \u1076 \u1080 \u1089 \u1087 \u1077 \u1090 \u1095 \u1077 \u1088 \u1091 ",1,"\u1062 \u1103  \u1110 \u1085 \u1092 \u1086 \u1088 \u1084 \u1072 \u1094 \u1110 \u1103  \u1076 \u1086 \u1087 \u1086 \u1084 \u1072 \u1075 \u1072 \u1108  \u1084 \u1077 \u1076 \u1080 \u1082 \u1072 \u1084  \u1086 \u1073 \u1088 \u1072 \u1090 \u1080  \u1087 \u1088 \u1072 \u1074 \u1080 \u1083 \u1100 \u1085 \u1077  \u1083 \u1110 \u1082 \u1091 \u1074 \u1072 \u1085 \u1085 \u1103 ."\
"\uc0\u1054 \u1087 \u1110 \u1082 \u1080 ",12,"\u1053 \u1077  \u1088 \u1086 \u1079 \u1087 \u1080 \u1090 \u1091 \u1074 \u1072 \u1090 \u1080  \u1085 \u1110 \u1082 \u1086 \u1075 \u1086 , \u1086 \u1073 \u1089 \u1090 \u1072 \u1074 \u1080 \u1085 \u1080  \u1090 \u1088 \u1072 \u1074 \u1084 \u1080  \u1085 \u1077  \u1084 \u1072 \u1102 \u1090 \u1100  \u1079 \u1085 \u1072 \u1095 \u1077 \u1085 \u1085 \u1103 ",0,"\u1054 \u1073 \u1089 \u1090 \u1072 \u1074 \u1080 \u1085 \u1080  (\u1095 \u1080 \u1084  \u1090 \u1072  \u1103 \u1082  \u1086 \u1073 \u1087 \u1110 \u1082 \u1089 \u1103 ) \u1074 \u1072 \u1078 \u1083 \u1080 \u1074 \u1110  \u1076 \u1083 \u1103  \u1084 \u1077 \u1076 \u1080 \u1082 \u1110 \u1074 ."\
"\uc0\u1052 \u1072 \u1089 \u1080 \u1074 \u1085 \u1072  \u1079 \u1086 \u1074 \u1085 \u1110 \u1096 \u1085 \u1103  \u1082 \u1088 \u1086 \u1074 \u1086 \u1090 \u1077 \u1095 \u1072 ",1,"\u1055 \u1077 \u1088 \u1077 \u1082 \u1086 \u1085 \u1072 \u1090 \u1080 \u1089 \u1103  \u1091  \u1074 \u1110 \u1076 \u1089 \u1091 \u1090 \u1085 \u1086 \u1089 \u1090 \u1110  \u1085 \u1077 \u1073 \u1077 \u1079 \u1087 \u1077 \u1082 \u1080 ",1,"\u1041 \u1077 \u1079 \u1087 \u1077 \u1082 \u1072  \u1088 \u1103 \u1090 \u1110 \u1074 \u1085 \u1080 \u1082 \u1072  \'97 \u1087 \u1077 \u1088 \u1096 \u1080 \u1081  \u1082 \u1088 \u1086 \u1082  \u1073 \u1091 \u1076 \u1100 -\u1103 \u1082 \u1086 \u1075 \u1086  \u1072 \u1083 \u1075 \u1086 \u1088 \u1080 \u1090 \u1084 \u1091 ."\
"\uc0\u1052 \u1072 \u1089 \u1080 \u1074 \u1085 \u1072  \u1079 \u1086 \u1074 \u1085 \u1110 \u1096 \u1085 \u1103  \u1082 \u1088 \u1086 \u1074 \u1086 \u1090 \u1077 \u1095 \u1072 ",1,"\u1054 \u1076 \u1088 \u1072 \u1079 \u1091  \u1090 \u1080 \u1089 \u1085 \u1091 \u1090 \u1080  \u1085 \u1072  \u1088 \u1072 \u1085 \u1091 , \u1085 \u1077  \u1079 \u1074 \u1077 \u1088 \u1090 \u1072 \u1102 \u1095 \u1080  \u1091 \u1074 \u1072 \u1075 \u1080  \u1085 \u1072  \u1085 \u1072 \u1074 \u1082 \u1086 \u1083 \u1080 \u1096 \u1085 \u1102  \u1086 \u1073 \u1089 \u1090 \u1072 \u1085 \u1086 \u1074 \u1082 \u1091 ",0,"\u1047 \u1072 \u1075 \u1088 \u1086 \u1079 \u1072  (\u1086 \u1073 \u1089 \u1090 \u1088 \u1110 \u1083 , \u1088 \u1091 \u1093  \u1090 \u1088 \u1072 \u1085 \u1089 \u1087 \u1086 \u1088 \u1090 \u1091 , \u1074 \u1086 \u1075 \u1086 \u1085 \u1100 ) \u1084 \u1086 \u1078 \u1077  \u1087 \u1088 \u1080 \u1079 \u1074 \u1077 \u1089 \u1090 \u1080  \u1076 \u1086  \u1085 \u1086 \u1074 \u1080 \u1093  \u1087 \u1086 \u1089 \u1090 \u1088 \u1072 \u1078 \u1076 \u1072 \u1083 \u1080 \u1093 ."\
"\uc0\u1052 \u1072 \u1089 \u1080 \u1074 \u1085 \u1072  \u1079 \u1086 \u1074 \u1085 \u1110 \u1096 \u1085 \u1103  \u1082 \u1088 \u1086 \u1074 \u1086 \u1090 \u1077 \u1095 \u1072 ",2,"\u1055 \u1086 \u1082 \u1083 \u1080 \u1082 \u1072 \u1090 \u1080  \u1085 \u1072  \u1076 \u1086 \u1087 \u1086 \u1084 \u1086 \u1075 \u1091 , \u1079 \u1074 \u1077 \u1088 \u1090 \u1072 \u1102 \u1095 \u1080 \u1089 \u1100  \u1076 \u1086  \u1082 \u1086 \u1085 \u1082 \u1088 \u1077 \u1090 \u1085 \u1086 \u1111  \u1086 \u1089 \u1086 \u1073 \u1080 ",1,"\u1047 \u1074 \u1077 \u1088 \u1085 \u1077 \u1085 \u1085 \u1103  \u1076 \u1086  \u1082 \u1086 \u1085 \u1082 \u1088 \u1077 \u1090 \u1085 \u1086 \u1111  \u1083 \u1102 \u1076 \u1080 \u1085 \u1080  \u1089 \u1087 \u1088 \u1072 \u1094 \u1100 \u1086 \u1074 \u1091 \u1108  \u1082 \u1088 \u1072 \u1097 \u1077 , \u1085 \u1110 \u1078  \u1079 \u1072 \u1075 \u1072 \u1083 \u1100 \u1085 \u1080 \u1081  \u1079 \u1072 \u1082 \u1083 \u1080 \u1082 ."\
"\uc0\u1052 \u1072 \u1089 \u1080 \u1074 \u1085 \u1072  \u1079 \u1086 \u1074 \u1085 \u1110 \u1096 \u1085 \u1103  \u1082 \u1088 \u1086 \u1074 \u1086 \u1090 \u1077 \u1095 \u1072 ",2,"\u1043 \u1086 \u1083 \u1086 \u1089 \u1085 \u1086  \u1082 \u1088 \u1080 \u1082 \u1085 \u1091 \u1090 \u1080  \u1074  \u1085 \u1072 \u1090 \u1086 \u1074 \u1087  \'ab\u1061 \u1090 \u1086 \u1089 \u1100 , \u1076 \u1086 \u1087 \u1086 \u1084 \u1086 \u1078 \u1110 \u1090 \u1100 !\'bb",0,"\u1050 \u1086 \u1078 \u1077 \u1085  \u1091  \u1085 \u1072 \u1090 \u1086 \u1074 \u1087 \u1110  \u1076 \u1091 \u1084 \u1072 \u1108 , \u1097 \u1086  \u1076 \u1086 \u1087 \u1086 \u1084 \u1086 \u1078 \u1077  \u1093 \u1090 \u1086 \u1089 \u1100  \u1110 \u1085 \u1096 \u1080 \u1081 . \u1055 \u1086 \u1090 \u1088 \u1110 \u1073 \u1085 \u1086  \u1079 \u1074 \u1077 \u1088 \u1090 \u1072 \u1090 \u1080 \u1089 \u1103  \u1076 \u1086  \u1082 \u1086 \u1085 \u1082 \u1088 \u1077 \u1090 \u1085 \u1086 \u1111  \u1086 \u1089 \u1086 \u1073 \u1080 ."\
"\uc0\u1052 \u1072 \u1089 \u1080 \u1074 \u1085 \u1072  \u1079 \u1086 \u1074 \u1085 \u1110 \u1096 \u1085 \u1103  \u1082 \u1088 \u1086 \u1074 \u1086 \u1090 \u1077 \u1095 \u1072 ",3,"\u1047 \u1072  \u1085 \u1072 \u1103 \u1074 \u1085 \u1086 \u1089 \u1090 \u1110  \u1074 \u1080 \u1082 \u1086 \u1088 \u1080 \u1089 \u1090 \u1072 \u1090 \u1080  \u1079 \u1072 \u1089 \u1086 \u1073 \u1080  \u1110 \u1085 \u1076 \u1080 \u1074 \u1110 \u1076 \u1091 \u1072 \u1083 \u1100 \u1085 \u1086 \u1075 \u1086  \u1079 \u1072 \u1093 \u1080 \u1089 \u1090 \u1091 : \u1088 \u1091 \u1082 \u1072 \u1074 \u1080 \u1095 \u1082 \u1080 , \u1084 \u1072 \u1089 \u1082 \u1091 , \u1079 \u1072 \u1093 \u1080 \u1089 \u1090  \u1086 \u1095 \u1077 \u1081 ",1,"\u1047 \u1030 \u1047  \u1079 \u1072 \u1093 \u1080 \u1097 \u1072 \u1102 \u1090 \u1100  \u1088 \u1103 \u1090 \u1110 \u1074 \u1085 \u1080 \u1082 \u1072  \u1074 \u1110 \u1076  \u1082 \u1086 \u1085 \u1090 \u1072 \u1082 \u1090 \u1091  \u1079  \u1082 \u1088 \u1086 \u1074 '\u1102 ."\
"\uc0\u1052 \u1072 \u1089 \u1080 \u1074 \u1085 \u1072  \u1079 \u1086 \u1074 \u1085 \u1110 \u1096 \u1085 \u1103  \u1082 \u1088 \u1086 \u1074 \u1086 \u1090 \u1077 \u1095 \u1072 ",3,"\u1053 \u1077  \u1074 \u1080 \u1090 \u1088 \u1072 \u1095 \u1072 \u1090 \u1080  \u1095 \u1072 \u1089  \u1085 \u1072  \u1088 \u1091 \u1082 \u1072 \u1074 \u1080 \u1095 \u1082 \u1080 , \u1085 \u1072 \u1074 \u1110 \u1090 \u1100  \u1103 \u1082 \u1097 \u1086  \u1074 \u1086 \u1085 \u1080  \u1108 ",0,"\u1040 \u1083 \u1075 \u1086 \u1088 \u1080 \u1090 \u1084  \u1074 \u1080 \u1084 \u1072 \u1075 \u1072 \u1108  \u1074 \u1080 \u1082 \u1086 \u1088 \u1080 \u1089 \u1090 \u1072 \u1090 \u1080  \u1085 \u1072 \u1103 \u1074 \u1085 \u1110  \u1047 \u1030 \u1047  \u1087 \u1077 \u1088 \u1077 \u1076  \u1085 \u1072 \u1076 \u1072 \u1085 \u1085 \u1103 \u1084  \u1076 \u1086 \u1087 \u1086 \u1084 \u1086 \u1075 \u1080 ."\
"\uc0\u1052 \u1072 \u1089 \u1080 \u1074 \u1085 \u1072  \u1079 \u1086 \u1074 \u1085 \u1110 \u1096 \u1085 \u1103  \u1082 \u1088 \u1086 \u1074 \u1086 \u1090 \u1077 \u1095 \u1072 ",4,"\u1052 \u1072 \u1082 \u1089 \u1080 \u1084 \u1072 \u1083 \u1100 \u1085 \u1086  \u1089 \u1080 \u1083 \u1100 \u1085 \u1086  \u1085 \u1072 \u1090 \u1080 \u1089 \u1085 \u1091 \u1090 \u1080  \u1085 \u1072  \u1088 \u1072 \u1085 \u1091  \u1088 \u1091 \u1082 \u1072 \u1084 \u1080 ",1,"\u1055 \u1088 \u1103 \u1084 \u1080 \u1081  \u1090 \u1080 \u1089 \u1082  \'97 \u1085 \u1072 \u1081 \u1096 \u1074 \u1080 \u1076 \u1096 \u1080 \u1081  \u1089 \u1087 \u1086 \u1089 \u1110 \u1073  \u1079 \u1084 \u1077 \u1085 \u1096 \u1080 \u1090 \u1080  \u1082 \u1088 \u1086 \u1074 \u1086 \u1090 \u1077 \u1095 \u1091 ."\
"\uc0\u1052 \u1072 \u1089 \u1080 \u1074 \u1085 \u1072  \u1079 \u1086 \u1074 \u1085 \u1110 \u1096 \u1085 \u1103  \u1082 \u1088 \u1086 \u1074 \u1086 \u1090 \u1077 \u1095 \u1072 ",4,"\u1055 \u1088 \u1086 \u1084 \u1080 \u1090 \u1080  \u1088 \u1072 \u1085 \u1091  \u1072 \u1085 \u1090 \u1080 \u1089 \u1077 \u1087 \u1090 \u1080 \u1082 \u1086 \u1084  \u1110  \u1096 \u1091 \u1082 \u1072 \u1090 \u1080  \u1074  \u1085 \u1110 \u1081  \u1089 \u1090 \u1086 \u1088 \u1086 \u1085 \u1085 \u1110  \u1087 \u1088 \u1077 \u1076 \u1084 \u1077 \u1090 \u1080 ",0,"\u1062 \u1077  \u1074 \u1090 \u1088 \u1072 \u1090 \u1072  \u1095 \u1072 \u1089 \u1091 , \u1087 \u1086 \u1082 \u1080  \u1081 \u1076 \u1077  \u1082 \u1088 \u1086 \u1074 \u1086 \u1090 \u1077 \u1095 \u1072 . \u1057 \u1087 \u1086 \u1095 \u1072 \u1090 \u1082 \u1091  \u1087 \u1086 \u1090 \u1088 \u1110 \u1073 \u1085 \u1086  \u1079 \u1091 \u1087 \u1080 \u1085 \u1080 \u1090 \u1080  \u1074 \u1090 \u1088 \u1072 \u1090 \u1091  \u1082 \u1088 \u1086 \u1074 \u1110 ."\
"\uc0\u1052 \u1072 \u1089 \u1080 \u1074 \u1085 \u1072  \u1079 \u1086 \u1074 \u1085 \u1110 \u1096 \u1085 \u1103  \u1082 \u1088 \u1086 \u1074 \u1086 \u1090 \u1077 \u1095 \u1072 ",5,"\u1053 \u1072 \u1082 \u1083 \u1072 \u1089 \u1090 \u1080  \u1087 \u1086 \u1074 '\u1103 \u1079 \u1082 \u1091 , \u1097 \u1086  \u1090 \u1080 \u1089 \u1085 \u1077 , \u1090 \u1072  \u1086 \u1094 \u1110 \u1085 \u1080 \u1090 \u1080  \u1111 \u1111  \u1077 \u1092 \u1077 \u1082 \u1090 \u1080 \u1074 \u1085 \u1110 \u1089 \u1090 \u1100 ",1,"\u1058 \u1080 \u1089 \u1085 \u1091 \u1095 \u1072  \u1087 \u1086 \u1074 '\u1103 \u1079 \u1082 \u1072  \u1087 \u1110 \u1076 \u1090 \u1088 \u1080 \u1084 \u1091 \u1108  \u1090 \u1080 \u1089 \u1082  \u1085 \u1072  \u1088 \u1072 \u1085 \u1091 . \u1045 \u1092 \u1077 \u1082 \u1090 \u1080 \u1074 \u1085 \u1110 \u1089 \u1090 \u1100  \u1089 \u1083 \u1110 \u1076  \u1087 \u1077 \u1088 \u1077 \u1074 \u1110 \u1088 \u1080 \u1090 \u1080 ."\
"\uc0\u1052 \u1072 \u1089 \u1080 \u1074 \u1085 \u1072  \u1079 \u1086 \u1074 \u1085 \u1110 \u1096 \u1085 \u1103  \u1082 \u1088 \u1086 \u1074 \u1086 \u1090 \u1077 \u1095 \u1072 ",5,"\u1053 \u1072 \u1082 \u1083 \u1072 \u1089 \u1090 \u1080  \u1074 \u1110 \u1083 \u1100 \u1085 \u1091  \u1087 \u1086 \u1074 '\u1103 \u1079 \u1082 \u1091 , \u1097 \u1086 \u1073  \u1085 \u1077  \u1079 \u1072 \u1074 \u1076 \u1072 \u1074 \u1072 \u1090 \u1080  \u1073 \u1086 \u1083 \u1102 ",0,"\u1042 \u1110 \u1083 \u1100 \u1085 \u1072  \u1087 \u1086 \u1074 '\u1103 \u1079 \u1082 \u1072  \u1085 \u1077  \u1079 \u1091 \u1087 \u1080 \u1085 \u1080 \u1090 \u1100  \u1082 \u1088 \u1086 \u1074 \u1086 \u1090 \u1077 \u1095 \u1091 ."\
"\uc0\u1052 \u1072 \u1089 \u1080 \u1074 \u1085 \u1072  \u1079 \u1086 \u1074 \u1085 \u1110 \u1096 \u1085 \u1103  \u1082 \u1088 \u1086 \u1074 \u1086 \u1090 \u1077 \u1095 \u1072 ",6,"\u1071 \u1082 \u1097 \u1086  \u1082 \u1088 \u1086 \u1074 \u1086 \u1090 \u1077 \u1095 \u1072  \u1085 \u1077  \u1079 \u1091 \u1087 \u1080 \u1085 \u1080 \u1083 \u1072 \u1089 \u1100 , \u1085 \u1072 \u1082 \u1083 \u1072 \u1089 \u1090 \u1080  \u1082 \u1088 \u1086 \u1074 \u1086 \u1089 \u1087 \u1080 \u1085 \u1085 \u1080 \u1081  \u1076 \u1078 \u1075 \u1091 \u1090  \u1085 \u1072  5\'967 \u1089 \u1084  \u1074 \u1080 \u1097 \u1077  \u1088 \u1072 \u1085 \u1080 ",1,"\u1044 \u1078 \u1075 \u1091 \u1090  \u1085 \u1072 \u1082 \u1083 \u1072 \u1076 \u1072 \u1102 \u1090 \u1100  \u1074 \u1080 \u1097 \u1077  \u1088 \u1072 \u1085 \u1080  \u1085 \u1072  \u1074 \u1110 \u1076 \u1089 \u1090 \u1072 \u1085 \u1110  5\'967 \u1089 \u1084 , \u1097 \u1086 \u1073  \u1087 \u1077 \u1088 \u1077 \u1090 \u1080 \u1089 \u1085 \u1091 \u1090 \u1080  \u1089 \u1091 \u1076 \u1080 \u1085 \u1080 ."\
"\uc0\u1052 \u1072 \u1089 \u1080 \u1074 \u1085 \u1072  \u1079 \u1086 \u1074 \u1085 \u1110 \u1096 \u1085 \u1103  \u1082 \u1088 \u1086 \u1074 \u1086 \u1090 \u1077 \u1095 \u1072 ",6,"\u1053 \u1072 \u1082 \u1083 \u1072 \u1089 \u1090 \u1080  \u1076 \u1078 \u1075 \u1091 \u1090  \u1073 \u1077 \u1079 \u1087 \u1086 \u1089 \u1077 \u1088 \u1077 \u1076 \u1085 \u1100 \u1086  \u1085 \u1072  \u1083 \u1110 \u1082 \u1090 \u1100 \u1086 \u1074 \u1080 \u1081  \u1072 \u1073 \u1086  \u1082 \u1086 \u1083 \u1110 \u1085 \u1085 \u1080 \u1081  \u1089 \u1091 \u1075 \u1083 \u1086 \u1073 ",0,"\u1053 \u1072  \u1089 \u1091 \u1075 \u1083 \u1086 \u1073 \u1072 \u1093  \u1076 \u1078 \u1075 \u1091 \u1090  \u1085 \u1072 \u1082 \u1083 \u1072 \u1076 \u1072 \u1090 \u1080  \u1085 \u1077  \u1084 \u1086 \u1078 \u1085 \u1072 : \u1074 \u1110 \u1085  \u1090 \u1072 \u1084  \u1085 \u1077  \u1087 \u1077 \u1088 \u1077 \u1090 \u1080 \u1089 \u1082 \u1072 \u1108  \u1089 \u1091 \u1076 \u1080 \u1085 \u1080  \u1077 \u1092 \u1077 \u1082 \u1090 \u1080 \u1074 \u1085 \u1086 ."\
"\uc0\u1052 \u1072 \u1089 \u1080 \u1074 \u1085 \u1072  \u1079 \u1086 \u1074 \u1085 \u1110 \u1096 \u1085 \u1103  \u1082 \u1088 \u1086 \u1074 \u1086 \u1090 \u1077 \u1095 \u1072 ",6,"\u1053 \u1072 \u1082 \u1083 \u1072 \u1089 \u1090 \u1080  \u1076 \u1078 \u1075 \u1091 \u1090  \u1085 \u1080 \u1078 \u1095 \u1077  \u1088 \u1072 \u1085 \u1080 ",0,"\u1044 \u1078 \u1075 \u1091 \u1090  \u1085 \u1072 \u1082 \u1083 \u1072 \u1076 \u1072 \u1108 \u1090 \u1100 \u1089 \u1103  \u1074 \u1080 \u1097 \u1077  \u1088 \u1072 \u1085 \u1080 . \u1053 \u1080 \u1078 \u1095 \u1077  \u1074 \u1110 \u1085  \u1082 \u1088 \u1086 \u1074 \u1086 \u1090 \u1077 \u1095 \u1091  \u1085 \u1077  \u1079 \u1091 \u1087 \u1080 \u1085 \u1080 \u1090 \u1100 ."\
"\uc0\u1052 \u1072 \u1089 \u1080 \u1074 \u1085 \u1072  \u1079 \u1086 \u1074 \u1085 \u1110 \u1096 \u1085 \u1103  \u1082 \u1088 \u1086 \u1074 \u1086 \u1090 \u1077 \u1095 \u1072 ",7,"\u1047 \u1072 \u1087 \u1080 \u1089 \u1072 \u1090 \u1080  \u1090 \u1086 \u1095 \u1085 \u1080 \u1081  \u1095 \u1072 \u1089  \u1085 \u1072 \u1082 \u1083 \u1072 \u1076 \u1072 \u1085 \u1085 \u1103  \u1076 \u1078 \u1075 \u1091 \u1090 \u1072  \u1085 \u1072  \u1085 \u1100 \u1086 \u1084 \u1091  \u1072 \u1073 \u1086  \u1085 \u1072  \u1074 \u1080 \u1076 \u1080 \u1084 \u1086 \u1084 \u1091  \u1084 \u1110 \u1089 \u1094 \u1110 ",1,"\u1052 \u1077 \u1076 \u1080 \u1082 \u1072 \u1084  \u1087 \u1086 \u1090 \u1088 \u1110 \u1073 \u1085 \u1086  \u1079 \u1085 \u1072 \u1090 \u1080 , \u1089 \u1082 \u1110 \u1083 \u1100 \u1082 \u1080  \u1095 \u1072 \u1089 \u1091  \u1082 \u1110 \u1085 \u1094 \u1110 \u1074 \u1082 \u1072  \u1073 \u1091 \u1083 \u1072  \u1073 \u1077 \u1079  \u1082 \u1088 \u1086 \u1074 \u1086 \u1087 \u1086 \u1089 \u1090 \u1072 \u1095 \u1072 \u1085 \u1085 \u1103 ."\
"\uc0\u1052 \u1072 \u1089 \u1080 \u1074 \u1085 \u1072  \u1079 \u1086 \u1074 \u1085 \u1110 \u1096 \u1085 \u1103  \u1082 \u1088 \u1086 \u1074 \u1086 \u1090 \u1077 \u1095 \u1072 ",7,"\u1053 \u1077  \u1092 \u1110 \u1082 \u1089 \u1091 \u1074 \u1072 \u1090 \u1080  \u1095 \u1072 \u1089 , \u1073 \u1088 \u1080 \u1075 \u1072 \u1076 \u1072  \u1089 \u1072 \u1084 \u1072  \u1088 \u1086 \u1079 \u1073 \u1077 \u1088 \u1077 \u1090 \u1100 \u1089 \u1103 ",0,"\u1040 \u1083 \u1075 \u1086 \u1088 \u1080 \u1090 \u1084  \u1074 \u1080 \u1084 \u1072 \u1075 \u1072 \u1108  \u1079 \u1072 \u1087 \u1080 \u1089 \u1072 \u1090 \u1080  \u1095 \u1072 \u1089  \u1072 \u1073 \u1086  \u1087 \u1077 \u1088 \u1077 \u1076 \u1072 \u1090 \u1080  \u1081 \u1086 \u1075 \u1086  \u1084 \u1077 \u1076 \u1080 \u1082 \u1072 \u1084 ."\
"\uc0\u1052 \u1072 \u1089 \u1080 \u1074 \u1085 \u1072  \u1079 \u1086 \u1074 \u1085 \u1110 \u1096 \u1085 \u1103  \u1082 \u1088 \u1086 \u1074 \u1086 \u1090 \u1077 \u1095 \u1072 ",8,"\u1071 \u1082 \u1097 \u1086  \u1082 \u1088 \u1086 \u1074 \u1086 \u1090 \u1077 \u1095 \u1072  \u1085 \u1077  \u1079 \u1091 \u1087 \u1080 \u1085 \u1080 \u1083 \u1072 \u1089 \u1100 , \u1079 \u1073 \u1110 \u1083 \u1100 \u1096 \u1080 \u1090 \u1080  \u1090 \u1080 \u1089 \u1082  \u1076 \u1078 \u1075 \u1091 \u1090 \u1072  \u1090 \u1072 /\u1072 \u1073 \u1086  \u1085 \u1072 \u1082 \u1083 \u1072 \u1089 \u1090 \u1080  \u1097 \u1077  \u1086 \u1076 \u1080 \u1085  \u1076 \u1078 \u1075 \u1091 \u1090  \u1074 \u1080 \u1097 \u1077  \u1087 \u1077 \u1088 \u1096 \u1086 \u1075 \u1086 ",1,"\u1053 \u1077 \u1076 \u1086 \u1089 \u1090 \u1072 \u1090 \u1085 \u1110 \u1081  \u1090 \u1080 \u1089 \u1082  \u1076 \u1078 \u1075 \u1091 \u1090 \u1072  \u1085 \u1077  \u1087 \u1077 \u1088 \u1077 \u1082 \u1088 \u1080 \u1074 \u1072 \u1108  \u1072 \u1088 \u1090 \u1077 \u1088 \u1110 \u1102 , \u1090 \u1086 \u1084 \u1091  \u1081 \u1086 \u1075 \u1086  \u1087 \u1086 \u1090 \u1088 \u1110 \u1073 \u1085 \u1086  \u1087 \u1086 \u1089 \u1080 \u1083 \u1080 \u1090 \u1080  \u1072 \u1073 \u1086  \u1076 \u1086 \u1076 \u1072 \u1090 \u1080  \u1097 \u1077  \u1086 \u1076 \u1080 \u1085 ."\
"\uc0\u1052 \u1072 \u1089 \u1080 \u1074 \u1085 \u1072  \u1079 \u1086 \u1074 \u1085 \u1110 \u1096 \u1085 \u1103  \u1082 \u1088 \u1086 \u1074 \u1086 \u1090 \u1077 \u1095 \u1072 ",8,"\u1055 \u1086 \u1089 \u1083 \u1072 \u1073 \u1080 \u1090 \u1080  \u1076 \u1078 \u1075 \u1091 \u1090  \u1110  \u1087 \u1086 \u1095 \u1077 \u1082 \u1072 \u1090 \u1080 , \u1097 \u1086  \u1082 \u1088 \u1086 \u1074 \u1086 \u1090 \u1077 \u1095 \u1072  \u1079 \u1091 \u1087 \u1080 \u1085 \u1080 \u1090 \u1100 \u1089 \u1103  \u1089 \u1072 \u1084 \u1072 ",0,"\u1055 \u1086 \u1089 \u1083 \u1072 \u1073 \u1083 \u1077 \u1085 \u1085 \u1103  \u1076 \u1078 \u1075 \u1091 \u1090 \u1072  \u1087 \u1088 \u1080  \u1090 \u1088 \u1080 \u1074 \u1072 \u1102 \u1095 \u1110 \u1081  \u1082 \u1088 \u1086 \u1074 \u1086 \u1090 \u1077 \u1095 \u1110  \u1085 \u1077 \u1073 \u1077 \u1079 \u1087 \u1077 \u1095 \u1085 \u1077  \u1076 \u1083 \u1103  \u1078 \u1080 \u1090 \u1090 \u1103 ."\
"\uc0\u1052 \u1072 \u1089 \u1080 \u1074 \u1085 \u1072  \u1079 \u1086 \u1074 \u1085 \u1110 \u1096 \u1085 \u1103  \u1082 \u1088 \u1086 \u1074 \u1086 \u1090 \u1077 \u1095 \u1072 ",9,"\u1053 \u1077  \u1079 \u1085 \u1110 \u1084 \u1072 \u1090 \u1080  \u1090 \u1072  \u1085 \u1077  \u1087 \u1086 \u1089 \u1083 \u1072 \u1073 \u1083 \u1103 \u1090 \u1080  \u1076 \u1078 \u1075 \u1091 \u1090  \u1076 \u1086  \u1087 \u1088 \u1080 \u1111 \u1079 \u1076 \u1091  \u1073 \u1088 \u1080 \u1075 \u1072 \u1076 \u1080  \u1077 \u1082 \u1089 \u1090 \u1088 \u1077 \u1085 \u1086 \u1111  \u1076 \u1086 \u1087 \u1086 \u1084 \u1086 \u1075 \u1080 ",1,"\u1047 \u1085 \u1110 \u1084 \u1072 \u1090 \u1080  \u1076 \u1078 \u1075 \u1091 \u1090  \u1084 \u1072 \u1108  \u1087 \u1088 \u1072 \u1074 \u1086  \u1083 \u1080 \u1096 \u1077  \u1084 \u1077 \u1076 \u1080 \u1082 ."\
"\uc0\u1052 \u1072 \u1089 \u1080 \u1074 \u1085 \u1072  \u1079 \u1086 \u1074 \u1085 \u1110 \u1096 \u1085 \u1103  \u1082 \u1088 \u1086 \u1074 \u1086 \u1090 \u1077 \u1095 \u1072 ",9,"\u1055 \u1086 \u1089 \u1083 \u1072 \u1073 \u1080 \u1090 \u1080  \u1076 \u1078 \u1075 \u1091 \u1090  \u1095 \u1077 \u1088 \u1077 \u1079  15 \u1093 \u1074 \u1080 \u1083 \u1080 \u1085 , \u1097 \u1086 \u1073  \u1082 \u1110 \u1085 \u1094 \u1110 \u1074 \u1082 \u1072  \u1085 \u1077  \u1087 \u1086 \u1084 \u1077 \u1088 \u1083 \u1072 ",0,"\u1047 \u1085 \u1110 \u1084 \u1072 \u1090 \u1080  \u1095 \u1080  \u1087 \u1086 \u1089 \u1083 \u1072 \u1073 \u1083 \u1102 \u1074 \u1072 \u1090 \u1080  \u1076 \u1078 \u1075 \u1091 \u1090  \u1089 \u1072 \u1084 \u1086 \u1089 \u1090 \u1110 \u1081 \u1085 \u1086  \u1079 \u1072 \u1073 \u1086 \u1088 \u1086 \u1085 \u1077 \u1085 \u1086 , \u1082 \u1088 \u1086 \u1074 \u1086 \u1090 \u1077 \u1095 \u1072  \u1084 \u1086 \u1078 \u1077  \u1074 \u1110 \u1076 \u1085 \u1086 \u1074 \u1080 \u1090 \u1080 \u1089 \u1103 ."\
"\uc0\u1052 \u1072 \u1089 \u1080 \u1074 \u1085 \u1072  \u1079 \u1086 \u1074 \u1085 \u1110 \u1096 \u1085 \u1103  \u1082 \u1088 \u1086 \u1074 \u1086 \u1090 \u1077 \u1095 \u1072 ",10,"\u1071 \u1082 \u1097 \u1086  \u1088 \u1072 \u1085 \u1091  \u1085 \u1077  \u1074 \u1080 \u1076 \u1085 \u1086 , \u1085 \u1072 \u1082 \u1083 \u1072 \u1089 \u1090 \u1080  \u1076 \u1078 \u1075 \u1091 \u1090  \u1084 \u1072 \u1082 \u1089 \u1080 \u1084 \u1072 \u1083 \u1100 \u1085 \u1086  \u1074 \u1080 \u1089 \u1086 \u1082 \u1086  \u1085 \u1072  \u1082 \u1110 \u1085 \u1094 \u1110 \u1074 \u1082 \u1091 ",1,"\u1058 \u1072 \u1082  \u1076 \u1078 \u1075 \u1091 \u1090  \u1075 \u1072 \u1088 \u1072 \u1085 \u1090 \u1086 \u1074 \u1072 \u1085 \u1086  \u1086 \u1087 \u1080 \u1085 \u1103 \u1108 \u1090 \u1100 \u1089 \u1103  \u1074 \u1080 \u1097 \u1077  \u1084 \u1110 \u1089 \u1094 \u1103  \u1082 \u1088 \u1086 \u1074 \u1086 \u1090 \u1077 \u1095 \u1110 ."\
"\uc0\u1052 \u1072 \u1089 \u1080 \u1074 \u1085 \u1072  \u1079 \u1086 \u1074 \u1085 \u1110 \u1096 \u1085 \u1103  \u1082 \u1088 \u1086 \u1074 \u1086 \u1090 \u1077 \u1095 \u1072 ",10,"\u1053 \u1077  \u1085 \u1072 \u1082 \u1083 \u1072 \u1076 \u1072 \u1090 \u1080  \u1076 \u1078 \u1075 \u1091 \u1090 , \u1076 \u1086 \u1082 \u1080  \u1085 \u1077  \u1079 \u1085 \u1072 \u1081 \u1076 \u1077 \u1090 \u1100 \u1089 \u1103  \u1088 \u1072 \u1085 \u1072 ",0,"\u1062 \u1077  \u1074 \u1090 \u1088 \u1072 \u1090 \u1072  \u1095 \u1072 \u1089 \u1091  \u1087 \u1088 \u1080  \u1084 \u1072 \u1089 \u1080 \u1074 \u1085 \u1110 \u1081  \u1082 \u1088 \u1086 \u1074 \u1086 \u1090 \u1077 \u1095 \u1110 . \u1071 \u1082 \u1097 \u1086  \u1088 \u1072 \u1085 \u1091  \u1085 \u1077  \u1074 \u1080 \u1076 \u1085 \u1086 , \u1076 \u1078 \u1075 \u1091 \u1090  \u1085 \u1072 \u1082 \u1083 \u1072 \u1076 \u1072 \u1102 \u1090 \u1100  \u1084 \u1072 \u1082 \u1089 \u1080 \u1084 \u1072 \u1083 \u1100 \u1085 \u1086  \u1074 \u1080 \u1089 \u1086 \u1082 \u1086 ."\
"\uc0\u1052 \u1072 \u1089 \u1080 \u1074 \u1085 \u1072  \u1079 \u1086 \u1074 \u1085 \u1110 \u1096 \u1085 \u1103  \u1082 \u1088 \u1086 \u1074 \u1086 \u1090 \u1077 \u1095 \u1072 ",11,"\u1055 \u1088 \u1080  \u1082 \u1088 \u1086 \u1074 \u1086 \u1090 \u1077 \u1095 \u1110  \u1079  \u1087 \u1072 \u1093 \u1074 \u1086 \u1074 \u1086 \u1111  \u1095 \u1080  \u1087 \u1072 \u1093 \u1074 \u1080 \u1085 \u1085 \u1086 \u1111  \u1076 \u1110 \u1083 \u1103 \u1085 \u1082 \u1080 , \u1089 \u1110 \u1076 \u1085 \u1080 \u1094 \u1100  \u1072 \u1073 \u1086  \u1086 \u1089 \u1085 \u1086 \u1074 \u1080  \u1096 \u1080 \u1111  \u1079 \u1088 \u1086 \u1073 \u1080 \u1090 \u1080  \u1090 \u1091 \u1075 \u1077  \u1090 \u1072 \u1084 \u1087 \u1086 \u1085 \u1091 \u1074 \u1072 \u1085 \u1085 \u1103  \u1075 \u1077 \u1084 \u1086 \u1089 \u1090 \u1072 \u1090 \u1080 \u1082 \u1086 \u1084  \u1095 \u1080  \u1084 \u1072 \u1088 \u1083 \u1077 \u1102  \u1081  \u1090 \u1080 \u1089 \u1085 \u1091 \u1090 \u1080  \u1085 \u1072  \u1088 \u1072 \u1085 \u1091  (3 \u1093 \u1074  \u1079  \u1075 \u1077 \u1084 \u1086 \u1089 \u1090 \u1072 \u1090 \u1080 \u1082 \u1086 \u1084 , 10 \u1093 \u1074  \u1079  \u1084 \u1072 \u1088 \u1083 \u1077 \u1102 )",1,"\u1059  \u1094 \u1080 \u1093  \u1084 \u1110 \u1089 \u1094 \u1103 \u1093  \u1076 \u1078 \u1075 \u1091 \u1090  \u1085 \u1077  \u1085 \u1072 \u1082 \u1083 \u1072 \u1089 \u1090 \u1080 , \u1090 \u1086 \u1084 \u1091  \u1074 \u1080 \u1082 \u1086 \u1088 \u1080 \u1089 \u1090 \u1086 \u1074 \u1091 \u1102 \u1090 \u1100  \u1090 \u1072 \u1084 \u1087 \u1086 \u1085 \u1091 \u1074 \u1072 \u1085 \u1085 \u1103  \u1079  \u1090 \u1088 \u1080 \u1074 \u1072 \u1083 \u1080 \u1084  \u1090 \u1080 \u1089 \u1082 \u1086 \u1084 ."\
"\uc0\u1052 \u1072 \u1089 \u1080 \u1074 \u1085 \u1072  \u1079 \u1086 \u1074 \u1085 \u1110 \u1096 \u1085 \u1103  \u1082 \u1088 \u1086 \u1074 \u1086 \u1090 \u1077 \u1095 \u1072 ",11,"\u1055 \u1088 \u1080  \u1082 \u1088 \u1086 \u1074 \u1086 \u1090 \u1077 \u1095 \u1110  \u1074  \u1087 \u1072 \u1093 \u1074 \u1080 \u1085 \u1085 \u1110 \u1081  \u1076 \u1110 \u1083 \u1103 \u1085 \u1094 \u1110  \u1085 \u1072 \u1082 \u1083 \u1072 \u1089 \u1090 \u1080  \u1076 \u1078 \u1075 \u1091 \u1090  \u1085 \u1072  \u1078 \u1080 \u1074 \u1110 \u1090 ",0,"\u1044 \u1078 \u1075 \u1091 \u1090  \u1091  \u1090 \u1072 \u1082 \u1080 \u1093  \u1076 \u1110 \u1083 \u1103 \u1085 \u1082 \u1072 \u1093  \u1085 \u1077  \u1085 \u1072 \u1082 \u1083 \u1072 \u1076 \u1072 \u1108 \u1090 \u1100 \u1089 \u1103 . \u1055 \u1086 \u1090 \u1088 \u1110 \u1073 \u1085 \u1077  \u1090 \u1072 \u1084 \u1087 \u1086 \u1085 \u1091 \u1074 \u1072 \u1085 \u1085 \u1103  \u1090 \u1072  \u1087 \u1088 \u1103 \u1084 \u1080 \u1081  \u1090 \u1080 \u1089 \u1082 ."\
"\uc0\u1052 \u1072 \u1089 \u1080 \u1074 \u1085 \u1072  \u1079 \u1086 \u1074 \u1085 \u1110 \u1096 \u1085 \u1103  \u1082 \u1088 \u1086 \u1074 \u1086 \u1090 \u1077 \u1095 \u1072 ",12,"\u1071 \u1082 \u1097 \u1086  \u1082 \u1088 \u1086 \u1074 \u1086 \u1090 \u1077 \u1095 \u1072  \u1079 \u1091 \u1087 \u1080 \u1085 \u1080 \u1083 \u1072 \u1089 \u1100 , \u1079 \u1072 \u1089 \u1087 \u1086 \u1082 \u1086 \u1111 \u1090 \u1080  \u1087 \u1086 \u1089 \u1090 \u1088 \u1072 \u1078 \u1076 \u1072 \u1083 \u1086 \u1075 \u1086  \u1090 \u1072  \u1074 \u1080 \u1082 \u1083 \u1080 \u1082 \u1072 \u1090 \u1080  \u1077 \u1082 \u1089 \u1090 \u1088 \u1077 \u1085 \u1091  \u1076 \u1086 \u1087 \u1086 \u1084 \u1086 \u1075 \u1091 ",1,"\u1055 \u1086 \u1089 \u1090 \u1088 \u1072 \u1078 \u1076 \u1072 \u1083 \u1086 \u1084 \u1091  \u1087 \u1086 \u1090 \u1088 \u1110 \u1073 \u1085 \u1072  \u1084 \u1077 \u1076 \u1080 \u1095 \u1085 \u1072  \u1076 \u1086 \u1087 \u1086 \u1084 \u1086 \u1075 \u1072 , \u1085 \u1072 \u1074 \u1110 \u1090 \u1100  \u1103 \u1082 \u1097 \u1086  \u1082 \u1088 \u1086 \u1074 \u1086 \u1090 \u1077 \u1095 \u1091  \u1074 \u1076 \u1072 \u1083 \u1086 \u1089 \u1103  \u1079 \u1091 \u1087 \u1080 \u1085 \u1080 \u1090 \u1080 ."\
"\uc0\u1052 \u1072 \u1089 \u1080 \u1074 \u1085 \u1072  \u1079 \u1086 \u1074 \u1085 \u1110 \u1096 \u1085 \u1103  \u1082 \u1088 \u1086 \u1074 \u1086 \u1090 \u1077 \u1095 \u1072 ",12,"\u1071 \u1082 \u1097 \u1086  \u1082 \u1088 \u1086 \u1074 \u1086 \u1090 \u1077 \u1095 \u1072  \u1079 \u1091 \u1087 \u1080 \u1085 \u1080 \u1083 \u1072 \u1089 \u1100 , \u1085 \u1110 \u1095 \u1086 \u1075 \u1086  \u1073 \u1110 \u1083 \u1100 \u1096 \u1077  \u1085 \u1077  \u1088 \u1086 \u1073 \u1080 \u1090 \u1080 ",0,"\u1055 \u1086 \u1090 \u1088 \u1110 \u1073 \u1085 \u1086  \u1079 \u1072 \u1089 \u1087 \u1086 \u1082 \u1086 \u1111 \u1090 \u1080  \u1087 \u1086 \u1089 \u1090 \u1088 \u1072 \u1078 \u1076 \u1072 \u1083 \u1086 \u1075 \u1086  \u1090 \u1072  \u1074 \u1080 \u1082 \u1083 \u1080 \u1082 \u1072 \u1090 \u1080  \u1077 \u1082 \u1089 \u1090 \u1088 \u1077 \u1085 \u1091  \u1076 \u1086 \u1087 \u1086 \u1084 \u1086 \u1075 \u1091 ."\
"\uc0\u1052 \u1072 \u1089 \u1080 \u1074 \u1085 \u1072  \u1079 \u1086 \u1074 \u1085 \u1110 \u1096 \u1085 \u1103  \u1082 \u1088 \u1086 \u1074 \u1086 \u1090 \u1077 \u1095 \u1072 ",13,"\u1071 \u1082 \u1097 \u1086  \u1087 \u1086 \u1089 \u1090 \u1088 \u1072 \u1078 \u1076 \u1072 \u1083 \u1080 \u1081  \u1074 \u1090 \u1088 \u1072 \u1090 \u1080 \u1074  \u1089 \u1074 \u1110 \u1076 \u1086 \u1084 \u1110 \u1089 \u1090 \u1100 , \u1086 \u1094 \u1110 \u1085 \u1080 \u1090 \u1080  \u1086 \u1079 \u1085 \u1072 \u1082 \u1080  \u1078 \u1080 \u1090 \u1090 \u1103  \u1090 \u1072  \u1087 \u1077 \u1088 \u1077 \u1081 \u1090 \u1080  \u1076 \u1086  \u1072 \u1083 \u1075 \u1086 \u1088 \u1080 \u1090 \u1084 \u1091  \u1087 \u1088 \u1080  \u1079 \u1091 \u1087 \u1080 \u1085 \u1094 \u1110  \u1082 \u1088 \u1086 \u1074 \u1086 \u1086 \u1073 \u1110 \u1075 \u1091 ",1,"\u1042 \u1090 \u1088 \u1072 \u1090 \u1072  \u1089 \u1074 \u1110 \u1076 \u1086 \u1084 \u1086 \u1089 \u1090 \u1110  \u1084 \u1086 \u1078 \u1077  \u1086 \u1079 \u1085 \u1072 \u1095 \u1072 \u1090 \u1080  \u1079 \u1091 \u1087 \u1080 \u1085 \u1082 \u1091  \u1082 \u1088 \u1086 \u1074 \u1086 \u1086 \u1073 \u1110 \u1075 \u1091 , \u1110  \u1090 \u1086 \u1076 \u1110  \u1087 \u1086 \u1090 \u1088 \u1110 \u1073 \u1085 \u1072  \u1057 \u1051 \u1056 ."\
"\uc0\u1052 \u1072 \u1089 \u1080 \u1074 \u1085 \u1072  \u1079 \u1086 \u1074 \u1085 \u1110 \u1096 \u1085 \u1103  \u1082 \u1088 \u1086 \u1074 \u1086 \u1090 \u1077 \u1095 \u1072 ",13,"\u1071 \u1082 \u1097 \u1086  \u1087 \u1086 \u1089 \u1090 \u1088 \u1072 \u1078 \u1076 \u1072 \u1083 \u1080 \u1081  \u1079 \u1085 \u1077 \u1087 \u1088 \u1080 \u1090 \u1086 \u1084 \u1085 \u1110 \u1074 , \u1087 \u1088 \u1086 \u1076 \u1086 \u1074 \u1078 \u1091 \u1074 \u1072 \u1090 \u1080  \u1083 \u1080 \u1096 \u1077  \u1090 \u1080 \u1089 \u1085 \u1091 \u1090 \u1080  \u1085 \u1072  \u1088 \u1072 \u1085 \u1091 ",0,"\u1055 \u1086 \u1090 \u1088 \u1110 \u1073 \u1085 \u1086  \u1087 \u1077 \u1088 \u1077 \u1074 \u1110 \u1088 \u1080 \u1090 \u1080  \u1086 \u1079 \u1085 \u1072 \u1082 \u1080  \u1078 \u1080 \u1090 \u1090 \u1103  \u1090 \u1072  \u1079 \u1072  \u1087 \u1086 \u1090 \u1088 \u1077 \u1073 \u1080  \u1088 \u1086 \u1079 \u1087 \u1086 \u1095 \u1072 \u1090 \u1080  \u1057 \u1051 \u1056 ."\
"\uc0\u1058 \u1088 \u1072 \u1074 \u1084 \u1072  \u1075 \u1086 \u1083 \u1086 \u1074 \u1080 ",1,"\u1055 \u1077 \u1088 \u1077 \u1082 \u1086 \u1085 \u1072 \u1090 \u1080 \u1089 \u1103  \u1091  \u1074 \u1110 \u1076 \u1089 \u1091 \u1090 \u1085 \u1086 \u1089 \u1090 \u1110  \u1085 \u1077 \u1073 \u1077 \u1079 \u1087 \u1077 \u1082 \u1080 ",1,"\u1056 \u1103 \u1090 \u1110 \u1074 \u1085 \u1080 \u1082  \u1085 \u1077  \u1087 \u1086 \u1074 \u1080 \u1085 \u1077 \u1085  \u1089 \u1090 \u1072 \u1074 \u1072 \u1090 \u1080  \u1085 \u1072 \u1089 \u1090 \u1091 \u1087 \u1085 \u1086 \u1102  \u1078 \u1077 \u1088 \u1090 \u1074 \u1086 \u1102 ."\
"\uc0\u1058 \u1088 \u1072 \u1074 \u1084 \u1072  \u1075 \u1086 \u1083 \u1086 \u1074 \u1080 ",1,"\u1054 \u1076 \u1088 \u1072 \u1079 \u1091  \u1087 \u1110 \u1076 \u1085 \u1110 \u1084 \u1072 \u1090 \u1080  \u1087 \u1086 \u1089 \u1090 \u1088 \u1072 \u1078 \u1076 \u1072 \u1083 \u1086 \u1075 \u1086 , \u1097 \u1086 \u1073  \u1087 \u1077 \u1088 \u1077 \u1085 \u1077 \u1089 \u1090 \u1080  \u1074  \u1073 \u1077 \u1079 \u1087 \u1077 \u1095 \u1085 \u1077  \u1084 \u1110 \u1089 \u1094 \u1077 ",0,"\u1041 \u1077 \u1079  \u1086 \u1094 \u1110 \u1085 \u1082 \u1080  \u1089 \u1080 \u1090 \u1091 \u1072 \u1094 \u1110 \u1111  \u1090 \u1072  \u1079 \u1072 \u1081 \u1074 \u1080 \u1093  \u1088 \u1091 \u1093 \u1110 \u1074  \u1084 \u1086 \u1078 \u1085 \u1072  \u1079 \u1072 \u1074 \u1076 \u1072 \u1090 \u1080  \u1096 \u1082 \u1086 \u1076 \u1080  \u1093 \u1088 \u1077 \u1073 \u1090 \u1091 ."\
"\uc0\u1058 \u1088 \u1072 \u1074 \u1084 \u1072  \u1075 \u1086 \u1083 \u1086 \u1074 \u1080 ",2,"\u1047 \u1072 \u1089 \u1087 \u1086 \u1082 \u1086 \u1111 \u1090 \u1080  \u1087 \u1086 \u1089 \u1090 \u1088 \u1072 \u1078 \u1076 \u1072 \u1083 \u1086 \u1075 \u1086  \u1090 \u1072  \u1087 \u1086 \u1103 \u1089 \u1085 \u1080 \u1090 \u1080  \u1089 \u1074 \u1086 \u1111  \u1087 \u1086 \u1076 \u1072 \u1083 \u1100 \u1096 \u1110  \u1076 \u1110 \u1111 ",1,"\u1057 \u1087 \u1086 \u1082 \u1110 \u1081  \u1076 \u1086 \u1087 \u1086 \u1084 \u1072 \u1075 \u1072 \u1108  \u1087 \u1086 \u1089 \u1090 \u1088 \u1072 \u1078 \u1076 \u1072 \u1083 \u1086 \u1084 \u1091  \u1085 \u1077  \u1088 \u1091 \u1093 \u1072 \u1090 \u1080 \u1089 \u1103  \u1079 \u1072 \u1081 \u1074 \u1080 \u1081  \u1088 \u1072 \u1079 ."\
